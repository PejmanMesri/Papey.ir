# ===== Papey E-Commerce Configuration =====
# Copy this file to .env and fill in real values.

# PostgreSQL
POSTGRES_USER=papey
POSTGRES_PASSWORD=papey123
POSTGRES_DB=papeydb
DB_HOST=localhost
DB_PORT=5434

# Zarinpal Payment Gateway (sandbox)
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:8080/payment/callback

# SMS.ir (Development always uses the sandbox key)
SMSIR_SANDBOX=true
SMSIR_SANDBOX_API_KEY=YOUR_SANDBOX_API_KEY_HERE
SMSIR_API_KEY=YOUR_PRODUCTION_API_KEY_HERE
SMSIR_SANDBOX_TEMPLATE_ID=123456
# Your SMS.ir dedicated sender line (required for bulk/fallback messages)
SMSIR_LINE_NUMBER=
# Approved production Verify templates; when blank, the dedicated line is used.
SMSIR_OTP_TEMPLATE_ID=
SMSIR_SHIPPING_TEMPLATE_ID=

# Admin seed account
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=@Admin1234
ADMIN_EMAIL=admin@papey.ir

# Site
SITE_NAME=Papey
SITE_DOMAIN=Papey.ir
