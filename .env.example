# ===== Papey E-Commerce Configuration =====
# Copy this file to .env and fill in real values.

# PostgreSQL
POSTGRES_USER=papey
POSTGRES_PASSWORD=papey123
POSTGRES_DB=papeydb
DB_HOST=localhost
DB_PORT=5434

# Zarinpal Payment Gateway (sandbox)
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:5200/payment/callback

# KaveNegar SMS
KAVENEGAR_API_KEY=YOUR_KAVENEGAR_API_KEY_HERE
KAVENEGAR_SENDER=
# Comma-separated list of admin phone numbers to notify on new purchase
ADMIN_PHONES=09010191905,09120000000

# Admin seed account
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=@Admin1234
ADMIN_EMAIL=admin@papey.ir

# Site
SITE_NAME=Papey
SITE_DOMAIN=Papey.ir
