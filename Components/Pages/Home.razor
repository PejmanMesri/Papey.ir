@page "/"
@inject IDbContextFactory<AppDbContext> DbFactory
<PageTitle>پاپی | تیشرت و هودی با طرح‌های خاص</PageTitle>
<section class="home-hero">
    <div class="home-hero-copy">
        <span class="home-eyebrow">پاپی • برای سلیقه‌ی تو</span>
        <h1>طرح تو<br /><span>استایل تو</span></h1>
        <p>از انیمه و گیم تا هنر و موسیقی؛ تیشرت و هودی‌ای پیدا کن که از علاقه‌های تو حرف می‌زند.</p>
        <div class="home-hero-actions"><a class="btn-papey" href="/products">پیدا کردن طرح من ←</a></div>
    </div>
    <div class="home-hero-gallery">
        @foreach (var product in _heroProducts)
        {
            <a class="home-hero-product" href="/product/@product.Slug"><img src="@product.ImageUrl" alt="@product.Name" fetchpriority="high" /><span>@product.Name <span aria-hidden="true">↗</span></span></a>
        }
        @if (_heroProducts.Count == 0) { <div class="home-hero-empty">پاپی<span>طرح‌های خاص برای روزهای تو</span></div> }
    </div>
</section>
<section class="home-category-section" aria-label="انتخاب مدل لباس">
    <div class="home-section-heading"><div><span class="home-eyebrow">از اینجا شروع کن</span><h2>کدام مدل برای توست؟</h2></div></div>
    <div class="home-categories">
        @foreach (var type in _types)
        {
            <a class="home-category" href="/products?type=@type.Id"><span class="home-category-icon" aria-hidden="true"><ProductTypeSymbol Value="@ProductTypeIcon(type)" /></span><div><h3>@type.Name</h3><span>دیدن همه طرح‌ها ←</span></div></a>
        }
    </div>
</section>
<section class="home-products-section">
    <div class="home-section-heading"><div><span class="home-eyebrow">تازه رسیده</span><h2>جدیدترین طرح‌ها</h2></div><a href="/products">همه محصولات ←</a></div>
    <ProductGrid Products="_newProducts" />
</section>
@if (_featured.Count > 0)
{
    <section class="home-products-section"><div class="home-section-heading"><div><span class="home-eyebrow">انتخاب‌های پاپی</span><h2>طرح‌های منتخب</h2></div><a href="/products">گشتن در فروشگاه ←</a></div><ProductGrid Products="_featured" /></section>
}
<section class="home-help">
    <div><span class="home-eyebrow">با خیال راحت انتخاب کن</span><h2>برای خرید کمک می‌خواهی؟</h2><p>سایزت را پیدا کن یا برای انتخاب طرح با ما در ارتباط باش.</p><a class="btn-papey btn-outline" href="/contact">ارتباط با پاپی</a></div>
    <div>
        <details class="faq-item"><summary>چطور سایز مناسب را انتخاب کنم؟</summary><div class="faq-body">در صفحه هر محصول، زیر گزینه‌های سایز روی «راهنمای انتخاب سایز» بزن و اندازه‌ها را با لباس خودت مقایسه کن.</div></details>
        <details class="faq-item"><summary>سفارش چطور ارسال می‌شود؟</summary><div class="faq-body">ارسال با تیپاکس انجام می‌شود و هزینه ارسال هنگام تحویل از گیرنده دریافت می‌شود. آماده‌سازی سفارش ۷ تا ۱۰ روز کاری زمان می‌برد.</div></details>
        <details class="faq-item"><summary>چطور خرید و سفارشم را پیگیری کنم؟</summary><div class="faq-body">وارد حساب شو، محصولات را به سبد اضافه کن و پس از ثبت نشانی، پرداخت را انجام بده. وضعیت خرید در بخش <a href="/account/orders">سفارش‌های من</a> نمایش داده می‌شود.</div></details>
    </div>
</section>
@code {
    private List<ProductTypeEntity> _types = new();
    private List<Product> _newProducts = new();
    private List<Product> _featured = new();
    private List<Product> _heroProducts = new();
    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _types = await db.ProductTypes.Where(t => t.IsActive).OrderBy(t => t.DisplayOrder).ToListAsync();
        _newProducts = await db.Products.Where(p => p.IsActive).OrderByDescending(p => p.CreatedAt).ThenByDescending(p => p.Id).Take(8).ToListAsync();
        _featured = await db.Products.Where(p => p.IsActive && p.IsFeatured).OrderByDescending(p => p.CreatedAt).Take(4).ToListAsync();
        _heroProducts = await db.Products.Where(p => p.IsActive && p.HomeHeroSlot != null)
            .OrderBy(p => p.HomeHeroSlot).Take(2).ToListAsync();
    }
    private static string ProductTypeIcon(ProductTypeEntity type)
        => string.IsNullOrWhiteSpace(type.FilterIcon) ? type.Name == "هودی" ? "🧥" : "👕" : type.FilterIcon;
}
