@page "/"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject HomepageSettings Homepage
@inject HomepageChanges Changes
@implements IDisposable

@if (_banners.Slides.Any(s => s.Active)) { <HomeBanner Slides="_banners.Slides.Where(s => s.Active).ToList()" IntervalSeconds="_banners.IntervalSeconds" /> }
<div class="homepage-content">
<section class="photo-types-section"><div class="editorial-section-heading"><div><span class="editorial-eyebrow">انتخاب تو / THE COLLECTION</span><h1>تیشرت چاپی، هودی چاپی و پوشاک طرح‌دار</h1></div><a href="/products">همه محصولات ↗</a></div>
    <div class="photo-type-grid">@foreach (var type in _types) { <a class="photo-type-card" href="/products?type=@type.Id"><ProductTypePhoto Id="@type.Id" TypeName="@type.Name" Value="@type.FilterIcon" /><div><h3>@type.Name</h3><span>مشاهده محصولات <b aria-hidden="true">↗</b></span></div></a> }</div>
</section>
<section class="editorial-custom"><div><span class="editorial-eyebrow">PAPEY CUSTOM / ایده از تو</span><h2>قرار نیست طرح تو<br />شبیه بقیه باشد.</h2><p>ایده‌ات را با ما در میان بگذار. برای انتخاب لباس، بررسی طرح و هماهنگی قیمت کنارت هستیم.</p><a class="editorial-hero-cta" href="/custom-design">سفارش تیشرت کاستوم ↗</a><small>ثبت شماره تماس یا گفت‌وگو در واتساپ</small></div><img src="/img/custom-studio/hoodie-white-front.webp" alt="هودی برای سفارش با طرح اختصاصی" loading="lazy" /></section>
<section class="editorial-products"><div class="editorial-section-heading"><div><span class="editorial-eyebrow">NEW ARRIVALS</span><h2>جدیدترین ها</h2></div><a href="/products">مشاهده همه ↗</a></div><ProductGrid Products="_newProducts" /></section>

@if (_featured.Count > 0) { <section class="editorial-products"><div class="editorial-section-heading"><div><span class="editorial-eyebrow">PAPEY PICKS</span><h2>منتخب‌ها</h2></div><a href="/products">گشتن در فروشگاه ↗</a></div><ProductGrid Products="_featured" /></section> }
<section class="seo-intro"><h2>طرح آماده یا طرح خودت؟</h2><p>برای <a href="/printed-tshirts">خرید تیشرت چاپی</a> یا <a href="/printed-hoodies">خرید هودی چاپی</a> طرح‌های آماده را ببین، یا برای <a href="/custom-design">سفارش تیشرت کاستوم</a> یا <a href="/custom-design">سفارش لباس چاپی با طرح دلخواه</a>، ایده خودت را با ما در میان بگذار. قبل از ارسال فایل، <a href="/guides/tshirt-print-design">راهنمای طراحی تیشرت چاپی</a> کمکت می‌کند اندازه، پس‌زمینه و محل چاپ را مشخص کنی. برای آشنایی با روش چاپ پاپی، <a href="/guides/dtf-printing">راهنمای چاپ DTF روی لباس</a> را بخوان.</p>
@if (_searchTypes.Count > 0) { <div class="clothing-search-links" aria-label="مدل‌های قابل سفارش">@foreach (var type in _searchTypes) { <a href="/products?type=@type.Id">خرید @ClothingSearchTerms.PrintedName(type.Name)</a> }</div> }
</section><section class="editorial-values"><div><span>۰۱ / انتخاب</span><h3>علاقه‌هایت را بپوش</h3><p>از انیمه و گیم تا موسیقی و هنر؛ انتخاب از دنیای تو.</p></div><div><span>۰۲ / اندازه</span><h3>با اطمینان انتخاب کن</h3><p>راهنمای اندازه هر مدل، کنار سایزهای محصول در دسترس است.</p></div><div><span>۰۳ / ارتباط</span><h3>در کنارت هستیم</h3><p>برای راهنمایی و پیگیری سفارش با پاپی در ارتباط باش.</p></div></section>
<section class="editorial-faq"><div><span class="editorial-eyebrow">GOOD TO KNOW</span><h2>قبل از انتخاب بعدی.</h2><a href="/contact">تماس با ما ↗</a></div><div><details class="faq-item"><summary>سفارش چطور ارسال می‌شود؟</summary><p>ارسال با تیپاکس به سراسر ایران است. هزینه ارسال هنگام تحویل از گیرنده دریافت می‌شود. آماده‌سازی سفارش ۷ تا ۱۰ روز کاری زمان می‌برد.</p></details><details class="faq-item"><summary>چطور سایزم را پیدا کنم؟</summary><p>زیر سایزهای هر محصول، راهنمای انتخاب سایز را باز کن و اندازه‌ها را با لباس خودت مقایسه کن.</p></details><details class="faq-item"><summary>طرح خودم را چطور سفارش بدهم؟</summary><p>در <a href="/custom-design">سفارش اختصاصی</a> شماره‌ات را ثبت کن یا در واتساپ پیام بده؛ جزئیات و قیمت را با تو هماهنگ می‌کنیم.</p></details></div></section>

</div>
@code {
    private bool _disposed;
    private void RefreshBanners() { if (!_disposed) _ = InvokeAsync(async () => { if (_disposed) return; _banners = await Homepage.ReadAsync(); StateHasChanged(); }); }
    public void Dispose() { _disposed = true; Changes.Changed -= RefreshBanners; }
    private HomepageContent _banners = new();
    private List<ProductTypeEntity> _types = [], _searchTypes = [];
    private List<Product> _newProducts = [], _featured = [];
    protected override async Task OnInitializedAsync()
    {
        Changes.Changed += RefreshBanners;
        _banners = await Homepage.ReadAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        _types = await db.ProductTypes.Where(t => t.IsActive).OrderBy(t => t.DisplayOrder).ToListAsync();
        var activeTypeIds=await db.Products.Where(p=>p.IsActive).Select(p=>p.ProductTypeId ?? p.Category.ProductTypeId).Distinct().ToListAsync();
        _searchTypes=_types.Where(t=>activeTypeIds.Contains(t.Id)).ToList();
        _newProducts = await db.Products.Include(p => p.Media).Where(p => p.IsActive).OrderByDescending(p => p.CreatedAt).ThenByDescending(p => p.Id).Take(8).ToListAsync();
        _featured = await db.Products.Include(p => p.Media).Where(p => p.IsActive && p.IsFeatured).OrderByDescending(p => p.CreatedAt).Take(4).ToListAsync();
    }
}
