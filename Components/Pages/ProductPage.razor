@page "/product/{Slug}"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject CartService Cart
@inject FavoriteService Favorites
@inject NavigationManager Nav

@if (_product is null)
{
    <div class="alert-papey alert-info" style="margin-top:32px; text-align:center">محصول یافت نشد.</div>
}
else
{
    <div class="product-detail">
        <div class="gallery">
            @if (_media.Count == 0)
            {
                <button class="product-photo-open" type="button" aria-label="نمایش و بزرگ‌نمایی تصویر محصول" aria-haspopup="dialog" @onclick="() => OpenPicture(_product.ImageUrl)"><img src="@_product.ImageUrl" alt="@_product.Name" fetchpriority="high" decoding="async" /><span>بزرگ‌نمایی تصویر ⤢</span></button>
            }
            else
            {
                var current = _media[_activeMedia];
                <div class="gallery-main">
                    @if (current.Type == MediaType.Video)
                    {
                        <video src="@current.Url" controls style="width:100%; border-radius:12px; border:1px solid var(--papey-border)"></video>
                    }
                    else
                    {
                        <button class="product-photo-open" type="button" aria-label="نمایش و بزرگ‌نمایی تصویر محصول" aria-haspopup="dialog" @onclick="() => OpenPicture(current.Url)"><img src="@current.Url" alt="@(current.Alt ?? _product.Name)" fetchpriority="high" decoding="async" /><span>بزرگ‌نمایی تصویر ⤢</span></button>
                    }
                </div>
                @if (_media.Count > 1)
                {
                    <div class="gallery-thumbs">
                        @for (var i = 0; i < _media.Count; i++)
                        {
                            var idx = i;
                            var m = _media[i];
                            <button type="button" class="gallery-thumb @(idx == _activeMedia ? "active" : "")" aria-label="@(m.Type == MediaType.Video ? "نمایش ویدیو" : $"بزرگ‌نمایی تصویر {idx + 1}")" aria-haspopup="@(m.Type == MediaType.Image ? "dialog" : null)" @onclick="() => SelectGalleryMedia(idx)">
                                @if (m.Type == MediaType.Video)
                                {
                                    <span class="thumb-video">▶</span>
                                }
                                else
                                {
                                    <img src="@m.Url" alt="@(m.Alt ?? _product.Name)" />
                                }
                            </button>
                        }
                    </div>
                }
            }
        </div>
        <div>
            <p style="color:var(--papey-muted); font-size:0.85rem">
                <a href="/">خانه</a>
                <span> / </span><a href="/category/@_product.Category.Slug">@_product.Category.Name</a>
            </p>
            <h1 style="margin:0 0 12px; font-size:1.7rem">@_product.Name</h1>
            <ProductPrice Price="SelectedPrice" OldPrice="_product.OldPrice" Detail="true" />

            <label class="form-label">رنگ: <strong>@_selectedColor</strong></label>
            <div>
                @foreach (var c in _colors)
                {
                    <button type="button" class="color-dot @(_selectedColor == c.Name ? "selected" : "")"
                          style="background:@c.Hex" title="@c.Name" aria-label="@c.Name" aria-pressed="@(_selectedColor == c.Name)"
                          @onclick="() => SelectColor(c.Name)"></button>
                }
            </div>
            <div class="color-name">@_selectedColor</div>

            <label class="form-label">سایز:</label>
            <div style="margin-bottom: 20px">
                @foreach (var s in _sizes)
                {
                    var size = s;
                    var inStock = HasStock(_selectedColor!, size);
                    <button type="button" class="size-chip @(_selectedSize == size ? "selected" : "") @(!inStock ? "out" : "")"
                          disabled="@(!inStock)" aria-pressed="@(_selectedSize == size)" aria-label="سایز @size"
                          @onclick="() => SelectSize(size, inStock)">@size</button>
                }
            </div>

            <ProductSizeGuide ProductName="@_product.Name" ImageUrl="@_product.SizeGuideImageUrl" ProductTypeId="@(_product.ProductTypeId ?? _product.Category?.ProductTypeId)" ProductTypeName="@_product.ProductType?.Name" />
            <label class="form-label">تعداد:</label>
            <div style="display:flex; align-items:center; margin-bottom: 24px">
                <div class="qty-box">
                    <button @onclick="() => { if (_qty > 1) _qty--; }">−</button>
                    <span>@PersianHelpers.ToPersianDigits(_qty.ToString())</span>
                    <button @onclick="() => { if (_qty < MaxQty) _qty++; }">+</button>
                </div>
                @if (MaxQty == 1)
                {
                    <small style="color:var(--papey-danger); font-weight:700">تنها ۱ عدد باقی مانده</small>
                }
            </div>

            <button class="btn-papey" style="width:100%" disabled="@(!CanAdd)" @onclick="AddToCart">
                🛒 افزودن به سبد خرید
            </button>
            <button class="btn-papey btn-outline favorite-detail-button @(_isFavorite ? "is-favorite" : "")"
                    type="button" @onclick="ToggleFavoriteAsync">
                @(_isFavorite ? "♥ حذف از علاقه‌مندی‌ها" : "♡ افزودن به علاقه‌مندی‌ها")
            </button>

            @if (_message is not null)
            {
                <div class="alert-papey @(_added ? "alert-success" : "alert-danger")">@_message</div>
            }

            <div class="card-box" style="margin-top: 24px; font-size:0.9rem; line-height:2">
                <strong>توضیحات:</strong>
                <p style="color:var(--papey-muted)">@_product.Description</p>
                <span>🚚 ارسال با تیپاکس به سراسر ایران</span><br />
                <span>🔒 پرداخت امن زرین‌پال</span>
            </div>
        </div>
    </div>
    <RelatedProducts @key='("related", _product.Id)' ProductId="_product.Id" />
    <ProductReviews @key='("reviews", _product.Id)' ProductId="_product.Id" Slug="@_product.Slug" />
}

<ProductImageLightbox @ref="_imageViewer" />
@code {
    [Parameter] public string Slug { get; set; } = "";

    private Product? _product;
    private async Task SelectGalleryMedia(int index)
    {
        _activeMedia = index;
        if (_media[index].Type == MediaType.Image) await OpenPicture(_media[index].Url);
    }
    private ProductImageLightbox? _imageViewer;
    private Task OpenPicture(string? selected) => _imageViewer?.ShowAsync(new[] { _product!.ImageUrl }.Concat(_media.Where(m => m.Type == MediaType.Image).Select(m => m.Url)).OfType<string>(), _product.Name, selectedImage: selected) ?? Task.CompletedTask;
    private List<ProductMedia> _media = new();
    private int _activeMedia;
    private List<(string Name, string Hex)> _colors = new();
    private List<string> _sizes = new();
    private string? _selectedColor;
    private string? _selectedSize;
    private int _qty = 1;
    private string? _message;
    private bool _added;
    private bool _isFavorite;

    private decimal SelectedPrice => _product?.Variants.FirstOrDefault(v=>v.IsEnabled && v.Color==_selectedColor && v.Size==_selectedSize)?.EffectivePrice ?? _product?.Price ?? 0;
    private int MaxQty => _product?.Variants.FirstOrDefault(v => v.Color == _selectedColor && v.Size == _selectedSize) is { } variant
        ? ProductInventory.MaximumQuantity(variant) : 0;
    private bool CanAdd => _selectedColor is not null && _selectedSize is not null && MaxQty > 0;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _product = await db.Products
            .Include(p => p.Category)
            .Include(p => p.ProductType)
            .Include(p => p.Variants)
            .Include(p => p.Media)
            .FirstOrDefaultAsync(p => p.Slug == Slug && p.IsActive);

        if (_product is not null)
        {
            _media = _product.Media.OrderBy(m => m.DisplayOrder).ToList();
            _activeMedia = 0;

            // Load active colors & sizes from DB (respect DisplayOrder)
            var activeColors = await db.Colors.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder).ToListAsync();
            var activeSizes = await db.Sizes.Where(s => s.IsActive).OrderBy(s => s.DisplayOrder).ToListAsync();

            // Only show colors with an enabled, available combination.
            var variantColors = _product.Variants
                .Where(v => ProductInventory.CanOrder(v, 1))
                .Select(v => v.Color).Distinct().ToHashSet();
            _colors = activeColors
                .Where(c => variantColors.Contains(c.Name))
                .Select(c => (c.Name, c.Hex))
                .ToList();

            _selectedColor = _colors.FirstOrDefault().Name;

            // Build sizes list filtered by selected color, ordered by DB order
            _activeSizeOrder = activeSizes.Select(s => s.Name).ToList();
            _sizes = _product.Variants
                .Where(v => v.IsEnabled && v.Color == _selectedColor && _activeSizeOrder.Contains(v.Size))
                .Select(v => v.Size).Distinct()
                .OrderBy(s => _activeSizeOrder.IndexOf(s) is var idx && idx >= 0 ? idx : 999)
                .ToList();
            _selectedSize = _sizes.FirstOrDefault(s => HasStock(_selectedColor, s)) ?? _sizes.FirstOrDefault();
            _qty = 1;
            _isFavorite = (await Favorites.GetProductIdsAsync()).Contains(_product.Id);
        }
    }

    private List<string> _activeSizeOrder = new();

    private bool HasStock(string? color, string size)
        => _product?.Variants.Any(v => v.Color == color && v.Size == size && ProductInventory.CanOrder(v, 1)) ?? false;

    private void SelectColor(string color)
    {
        _selectedColor = color;
        // Rebuild the size list for the newly-selected color, ordered by DB
        _sizes = _product!.Variants
            .Where(v => v.IsEnabled && v.Color == color && _activeSizeOrder.Contains(v.Size))
            .Select(v => v.Size).Distinct()
            .OrderBy(s => _activeSizeOrder.IndexOf(s) is var idx && idx >= 0 ? idx : 999)
            .ToList();

        // Pick the first in-stock size, or fall back to first size
        if (_selectedSize is null || !HasStock(color, _selectedSize))
            _selectedSize = _sizes.FirstOrDefault(s => HasStock(color, s)) ?? _sizes.FirstOrDefault();

        // Reset quantity to 1 and clear any previous message
        _qty = 1;
        _message = null;
    }

    private void SelectSize(string size, bool inStock)
    {
        if (!inStock) return;
        _selectedSize = size;
        _qty = 1;
        _message = null;
    }

    private async Task AddToCart()
    {
        if (!CanAdd) return;
        var ok = await Cart.AddAsync(_product!.Id, _selectedColor!, _selectedSize!, _qty);
        _added = ok;
        _message = ok ? "✓ محصول به سبد خرید اضافه شد." : "موجودی کافی نیست.";
    }

    private async Task ToggleFavoriteAsync()
    {
        if (_product is null) return;
        if (!await Favorites.ToggleAsync(_product.Id))
        {
            var returnUrl = "/" + Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
            return;
        }

        _isFavorite = !_isFavorite;
    }
}
