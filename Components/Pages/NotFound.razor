@page "/not-found"
@layout MainLayout

<PageTitle>صفحه پیدا نشد | پاپی</PageTitle>
<HeadContent><meta name="robots" content="noindex" /></HeadContent>

<section class="not-found-page" aria-labelledby="not-found-title">
    <div class="not-found-art" aria-hidden="true">
        <span>404</span>
        <svg viewBox="0 0 160 160" fill="none">
            <path d="m56 31-32 20 16 30 16-8v57h48V73l16 8 16-30-32-20c-3 16-45 16-48 0Z" />
            <path d="M66 32c1 10 27 10 28 0M66 101h28M66 110h18" />
        </svg>
    </div>
    <div class="not-found-content">
        <p class="not-found-eyebrow">این مسیر به جایی نمی‌رسد</p>
        <h1 id="not-found-title">این صفحه پیدا نشد.</h1>
        <p class="not-found-description">شاید آدرس تغییر کرده یا صفحه حذف شده باشد. هنوز کلی طرح برای پیدا کردن هست!</p>
        <div class="not-found-actions">
            <a class="btn-papey" href="/products">دیدن همه محصولات <span aria-hidden="true">←</span></a>
            <a class="btn-papey btn-outline" href="/">بازگشت به خانه</a>
        </div>
        <a class="not-found-help" href="/contact">کمک می‌خواهی؟ با پاپی در ارتباط باش</a>
    </div>
</section>
