@page "/payment/callback"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ZarinpalService Zarinpal
@inject OrderAdminSmsQueue AdminSms
@inject CartService Cart
@inject IJSRuntime JS

<PageTitle>نتیجه پرداخت | پاپی</PageTitle>

<div style="max-width:560px; margin:64px auto">
    <div class="card-box" style="text-align:center">
        @if (_loading)
        {
            <p>در حال بررسی پرداخت...</p>
        }
        else if (_order is not null && _order.Status == OrderStatus.Paid)
        {
            <p style="font-size:4rem; margin:8px">✅</p>
            <h2>پرداخت با موفقیت انجام شد</h2>
            <p style="font-size:1.1rem; font-weight:800; color:var(--papey-success); margin:4px 0 12px">از خرید شما متشکریم 🌿</p>
            <p>سفارش شما با شماره <strong>@_order.OrderNumber</strong> ثبت شد.</p>

            @if (_order.Items.Count > 0)
            {
                <div style="text-align:right; margin:16px 0">
                    <h3 style="font-size:0.95rem; margin:0 0 8px">🛒 محصولات خریداری‌شده</h3>
                    <table class="table-papey">
                        <thead><tr><th>محصول</th><th>رنگ</th><th>سایز</th><th>تعداد</th><th>جمع</th></tr></thead>
                        <tbody>
                            @foreach (var i in _order.Items)
                            {
                                <tr>
                                    <td>@i.ProductName</td>
                                    <td>@i.Color</td>
                                    <td>@i.Size</td>
                                    <td>@PersianHelpers.ToPersianDigits(i.Quantity.ToString())</td>
                                    <td>@i.LineTotal.ToToman()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="alert-papey alert-info" style="font-size:0.9rem">🚚 تحویل ۷ الی ۱۰ روز کاری زمان می‌برد</div>

            <p style="color:var(--papey-muted); font-size:0.9rem">
                کد پیگیری پرداخت: <strong>@PersianHelpers.ToPersianDigits(_order.PaymentRefId ?? "")</strong><br />
                مبلغ: <strong>@_order.GrandTotal.ToToman()</strong>
            </p>
            @if (_invoiceOpenAttempted)
            {
                <p style="font-size:0.82rem; color:var(--papey-muted)">
                    @(_invoiceOpened ? "فاکتور سفارش در برگه جدید باز شد." : "باز شدن خودکار فاکتور توسط مرورگر مسدود شد؛ از دکمه زیر استفاده کنید.")
                </p>
            }
            <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap">
                <a class="btn-papey btn-outline" href="/account/orders/@_order.Id/invoice" target="_blank" rel="noopener">مشاهده فاکتور</a>
                <a class="btn-papey" href="/">بازگشت به فروشگاه</a>
            </div>
        }
        else
        {
            <p style="font-size:4rem; margin:8px">❌</p>
            <h2>پرداخت ناموفق بود</h2>
            <p>@_message</p>
            <div style="display:flex; gap:12px; justify-content:center">
                <a class="btn-papey" href="/cart">بازگشت به سبد خرید</a>
                <a class="btn-papey btn-outline" href="/">صفحه اصلی</a>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Authority { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }

    private bool _loading = true;
    private Order? _order;
    private string? _message;
    private bool _invoiceOpenAttempted;
    private bool _invoiceOpened;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _order = await db.Orders.Include(o => o.Items)
            .FirstOrDefaultAsync(o => o.PaymentAuthority == Authority);

        if (_order is null) { _message = "سفارش یافت نشد."; _loading = false; return; }

        // A repeated or cancelled callback must not downgrade a paid/shipped order.
        if (_order.PaidAt is not null) { _loading = false; return; }

        if (Status != "OK")
        {
            await db.Orders.Where(o => o.Id == _order.Id && o.PaidAt == null)
                .ExecuteUpdateAsync(set => set.SetProperty(o => o.Status, OrderStatus.PaymentFailed));
            await db.Entry(_order).ReloadAsync();
            _message = "پرداخت توسط کاربر لغو شد یا ناموفق بود.";
            _loading = false;
            return;
        }

        // Idempotency: don't verify twice
        if (_order.Status == OrderStatus.Paid) { _loading = false; return; }

        var verify = await Zarinpal.VerifyPaymentAsync(Authority!, (long)(_order.GrandTotal * 10));
        if (verify.Success)
        {
            await using var tx = await db.Database.BeginTransactionAsync();
            await db.Database.ExecuteSqlInterpolatedAsync($"SELECT 1 FROM \"Orders\" WHERE \"Id\" = {_order.Id} FOR UPDATE");
            await db.Entry(_order).ReloadAsync();
            if (_order.PaidAt is not null) { _loading = false; return; }
            _order.Status = OrderStatus.Paid;
            _order.PaymentRefId = verify.RefId.ToString();
            _order.PaidAt = DateTime.UtcNow;
            await AdminSms.EnqueueAsync(db, _order);
            await db.SaveChangesAsync();
            await tx.CommitAsync();
            await Cart.ClearAsync();
        }
        else
        {
            await db.Orders.Where(o => o.Id == _order.Id && o.PaidAt == null)
                .ExecuteUpdateAsync(set => set.SetProperty(o => o.Status, OrderStatus.PaymentFailed));
            await db.Entry(_order).ReloadAsync();
            _message = $"تأیید پرداخت ناموفق بود. {verify.Error}";
        }
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _order?.Status != OrderStatus.Paid) return;

        _invoiceOpenAttempted = true;
        _invoiceOpened = await JS.InvokeAsync<bool>("papey.openOrderInvoiceOnce", _order.Id, $"/account/orders/{_order.Id}/invoice");
        await InvokeAsync(StateHasChanged);
    }
}
