@page "/wholesale"
@inject StorePageTexts Pages
<PageTitle>تولید و پخش عمده پوشاک سفارشی | پاپی</PageTitle>
<div class="wholesale-landing">
    <section class="wholesale-hero" aria-labelledby="wholesale-title">
        <div class="wholesale-intro">
            <span class="wholesale-eyebrow">@Text("eyebrow")</span>
            <h1 id="wholesale-title" class="page-text-lines">@Text("heading")</h1>
            <p class="wholesale-lead page-text-lines">@Text("intro")</p>
            <div class="wholesale-hero-actions"><a class="btn-papey" href="#wholesale-contact">@Text("button") <span aria-hidden="true">↙</span></a><span class="wholesale-experience"><strong>@Text("experience")</strong><span class="page-text-lines">@Text("experienceText")</span></span></div>
        </div>
        <div class="wholesale-visual"><img src="/img/custom-studio/hoodie-black-front.webp" alt="هودی مشکی پاپی برای تولید و سفارش پوشاک" fetchpriority="high" /><div class="wholesale-photo-caption"><span>@Text("photoCaption")</span><span lang="en">@Text("photoCaptionEnglish")</span></div></div>
    </section>

    <section class="wholesale-contact" id="wholesale-contact" aria-labelledby="contact-title"><div><span class="wholesale-eyebrow">@Text("contactEyebrow")</span><h2 id="contact-title">@Text("contactHeading")</h2><p class="page-text-lines">@Text("contactBody")</p><strong class="wholesale-signature">@Text("signature")</strong></div><div class="wholesale-contact-actions"><a class="wholesale-phone" href="@($"tel:{StorePageTexts.ContactPhone}")" aria-label="@($"تماس با فروش عمده پاپی، {Phone}")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 3h4l2 5-3 2a16 16 0 0 0 6 6l2-3 5 2v4a2 2 0 0 1-2 2A18 18 0 0 1 3 5a2 2 0 0 1 2-2Z"/></svg><span dir="ltr">@Phone</span><small>@Text("callButton")</small></a><a class="wholesale-whatsapp" href="https://wa.me/989121838991" target="_blank" rel="noopener">@Text("whatsappButton") <span aria-hidden="true">↗</span></a></div></section>

    <section class="wholesale-range" aria-labelledby="range-title">
        <div class="wholesale-section-heading"><span class="wholesale-eyebrow">۰۱ / دامنه تولید</span><h2 id="range-title">@Text("rangeHeading")</h2></div>
        <p class="page-text-lines">@Text("rangeBody")</p>
        <ul class="wholesale-garments" aria-label="انواع پوشاک قابل سفارش">@foreach (var item in Lines("garments")) { <li>@item</li> }</ul>
        <div class="wholesale-possibilities"><span class="wholesale-line-mark" aria-hidden="true">↗</span><p class="page-text-lines">@Text("possibilities")</p></div>
    </section>

    <section class="wholesale-organizations" aria-labelledby="organizations-title">
        <div class="wholesale-section-heading"><span class="wholesale-eyebrow">۰۲ / همکاری سازمانی</span><h2 id="organizations-title">@Text("organizationsHeading")</h2></div>
        <p class="page-text-lines">@Text("organizationsBody")</p>
        <div class="wholesale-services">@foreach (var item in Lines("services")) { <article><h3>@item</h3></article> }</div>
    </section>

    <section class="wholesale-promise" aria-labelledby="promise-title"><span class="wholesale-eyebrow">تعهد پاپی</span><h2 id="promise-title">@Text("promiseHeading")</h2><p class="page-text-lines">@Text("promiseBody")</p><div>@foreach (var item in Lines("promises")) { <span>@item</span> }</div></section>
</div>

@code {
    private Dictionary<string, string>? _texts;
    private static string Phone => PersianHelpers.ToPersianDigits(StorePageTexts.ContactPhone);
    private string Text(string key) => _texts?.GetValueOrDefault(key) ?? StorePageTexts.Wholesale.First(field => field.Key == key).Default;
    private string[] Lines(string key) => Text(key).Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
    protected override async Task OnInitializedAsync() => _texts = await Pages.ReadAsync("wholesale");
}
