@page "/about"
@inject StorePageTexts Pages
<PageTitle>درباره پاپی؛ پارچه‌ها، کیفیت و راه‌های ارتباط</PageTitle>
<div class="about-landing">
<section class="about-hero" aria-labelledby="about-title">
    <div class="about-intro"><span class="about-eyebrow">@Text("eyebrow")</span><h1 class="page-text-lines" id="about-title">@Text("heading")</h1>@foreach (var paragraph in Text("body").Split('\n', StringSplitOptions.RemoveEmptyEntries)) { <p>@paragraph</p> }<SocialLinks /><div class="editorial-actions"><a class="btn-papey" href="/products">@Text("shopButton")</a><a class="editorial-link" href="#contact">@Text("contactButton")</a></div></div>
    <div class="about-photo"><img src="/img/custom-studio/tshirt-black-front.webp" alt="تیشرت مشکی پاپی" fetchpriority="high" /><span>@Text("imageCaption")</span></div>
</section>
<section class="about-materials" aria-labelledby="materials-title"><div class="about-section-heading"><span class="about-eyebrow">PAPEY / MATERIALS</span><h2 id="materials-title">انتخاب متریال، متناسب با لباس شما.</h2></div>
<div class="about-fabric-grid">
<article class="about-fabric about-fabric-light"><div class="fabric-heading"><span aria-hidden="true">۰۱</span><span class="fabric-weave" aria-hidden="true"></span></div><h3>@Text("twoThreadTitle")</h3>@foreach(var paragraph in Text("twoThreadBody").Split('\n',StringSplitOptions.RemoveEmptyEntries)){<p>@paragraph</p>}</article>
<article class="about-fabric about-fabric-warm"><div class="fabric-heading"><span aria-hidden="true">۰۲</span><span class="fabric-weave" aria-hidden="true"></span></div><h3>@Text("threeThreadTitle")</h3>@foreach(var paragraph in Text("threeThreadBody").Split('\n',StringSplitOptions.RemoveEmptyEntries)){<p>@paragraph</p>}</article>
</div></section>
<section class="about-quality" aria-labelledby="quality-title"><div><span class="about-eyebrow">تعهد پوشاک پاپی</span><h2 id="quality-title">@Text("qualityTitle")</h2></div><div>@foreach(var paragraph in Text("qualityBody").Split('\n',StringSplitOptions.RemoveEmptyEntries)){<p>@paragraph</p>}<a href="/wholesale">تولید و سفارش عمده پوشاک <span aria-hidden="true">↗</span></a></div></section>
<div id="contact" class="about-contact"><ContactDetails /></div>
</div>
@code {
    private Dictionary<string,string>? _texts;
    private string Text(string key) => _texts?.GetValueOrDefault(key) ?? StorePageTexts.About.First(f => f.Key == key).Default;
    protected override async Task OnInitializedAsync() => _texts = await Pages.ReadAsync("about");
}
