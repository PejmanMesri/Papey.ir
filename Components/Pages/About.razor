@page "/about"
@inject StorePageTexts Pages
<PageTitle>درباره و ارتباط با ما | پاپی</PageTitle>
<section class="story-page">
    <div class="story-photo"><img src="/img/custom-studio/tshirt-black-front.webp" alt="تیشرت پاپی" /><span>@Text("imageCaption")</span></div>
    <div class="story-copy"><span class="editorial-eyebrow">@Text("eyebrow")</span><h1 class="page-text-lines">@Text("heading")</h1>@foreach (var paragraph in Text("body").Split('\n', StringSplitOptions.RemoveEmptyEntries)) { <p>@paragraph</p> }<SocialLinks /><div class="editorial-actions"><a class="btn-papey" href="/products">@Text("shopButton")</a><a class="editorial-link" href="#contact">@Text("contactButton")</a></div></div>
</section>

<div id="contact"><ContactDetails /></div>
@code {
    private Dictionary<string,string>? _texts;
    private string Text(string key) => _texts?.GetValueOrDefault(key) ?? StorePageTexts.About.First(f => f.Key == key).Default;
    protected override async Task OnInitializedAsync() => _texts = await Pages.ReadAsync("about");
}
