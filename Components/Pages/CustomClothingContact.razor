@page "/custom-design"
<PageTitle>سفارش تیشرت کاستوم و لباس چاپی | پاپی</PageTitle>
<section class="custom-contact-page">
    <div class="custom-contact-art"><img src="/img/custom-studio/hoodie-white-front.webp" alt="هودی برای چاپ طرح اختصاصی" /><span>YOUR IDEA.<br />YOUR PAPEY.</span></div>
    <div class="custom-contact-copy"><span class="editorial-eyebrow">سفارش اختصاصی / PAPEY CUSTOM</span><h1>سفارش تیشرت کاستوم<br />با طرح دلخواه تو.</h1>
        <p>طرح مورد علاقه‌ات را روی تیشرت، هودی یا لانگ اسلیو می‌خواهی؟ برای بررسی طرح، انتخاب لباس و هماهنگی قیمت با ما در ارتباط باش.</p>
        @if (SentValue == "1") { <div class="callback-success" role="status"><strong>شماره‌ات ثبت شد.</strong><p>تیم پاپی برای بررسی ایده و هماهنگی جزئیات با تو تماس می‌گیرد.</p></div> }
        else
        {
            <form class="callback-form" action="/custom-design/request-call" method="post">
                <AntiforgeryToken />
                <label for="callback-phone">شماره‌ات را بگذار، با تو تماس می‌گیریم.</label>
                <div><input id="callback-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="30" placeholder="09xxxxxxxxx" dir="ltr" aria-describedby="callback-hint" /><button class="btn-papey" type="submit">درخواست تماس ←</button></div>
                <label class="callback-trap" aria-hidden="true">وب‌سایت<input name="website" tabindex="-1" autocomplete="off" /></label>
                <small id="callback-hint">فقط برای پیگیری درخواستت تماس می‌گیریم. ثبت درخواست رایگان است.</small>
                @if (InvalidValue == "1") { <p class="callback-error" role="alert">لطفاً یک شماره موبایل معتبر وارد کن.</p> }
            </form>
        }
        <div class="contact-divider"><span>یا همین حالا گفت‌وگو کنیم</span></div>
        <a class="whatsapp-cta btn-papey btn-outline" href="@WhatsAppUrl" target="_blank" rel="noopener">گفت‌وگو درباره طرح من در واتساپ <span aria-hidden="true">↗</span></a>
        <p class="custom-contact-note">عکس طرح و جزئیاتش را در واتساپ بفرست. قیمت، زمان آماده‌سازی و محل چاپ پیش از نهایی شدن سفارش با تو هماهنگ می‌شود.</p>
    </div>
</section>
<section class="custom-contact-steps"><article><b>۰۱</b><h2>در ارتباط باشیم</h2><p>شماره‌ات را ثبت کن یا در واتساپ پیام بده.</p></article><article><b>۰۲</b><h2>جزئیات را هماهنگ کنیم</h2><p>طرح، مدل لباس، اندازه چاپ و قیمت را با هم بررسی می‌کنیم.</p></article><article><b>۰۳</b><h2>لباس تو، با ایده تو</h2><p>بعد از تأیید تو، مراحل ثبت سفارش و آماده‌سازی هماهنگ می‌شود.</p></article></section>
@code {
    [SupplyParameterFromQuery(Name = "sent")] public string? SentValue { get; set; }
    [SupplyParameterFromQuery(Name = "invalid")] public string? InvalidValue { get; set; }
    private static string WhatsAppUrl => "https://wa.me/989036421161?text=" + Uri.EscapeDataString("سلام پاپی، برای سفارش لباس با طرح اختصاصی پیام می‌دهم. می‌خواهم درباره طرح، مدل لباس و قیمت با شما هماهنگ کنم.");
}

<section class="seo-reading"><h2>فایل طرح خودت را برای چاپ آماده کن</h2><p>برای سفارش تیشرت کاستوم، فایل اصلی طرح، رنگ و سایز لباس، تعداد و جای چاپ مورد نظر را آماده کن. پیش از نهایی شدن سفارش، امکان اجرای طرح، قیمت و زمان با تو هماهنگ می‌شود.</p><p><a href="/guides/tshirt-print-design">راهنمای طراحی تیشرت چاپی و آماده‌سازی فایل ←</a> | <a href="/printed-tshirts">دیدن تیشرت‌های چاپی آماده</a></p></section>

<section class="seo-reading"><h2>سفارش لباس چاپی؛ از تیشرت تا هودی</h2><p>چاپ طرح‌های پاپی با روش <a href="/guides/dtf-printing">DTF (دی‌تی‌اف)</a> انجام می‌شود. برای سفارش تیشرت DTF یا لباس با طرح اختصاصی، فایل و جزئیات اجرا را با تیم هماهنگ کن.</p><p>برای چاپ طرح دلخواه روی لباس، نوع لباس را هم در درخواستت مشخص کن: تیشرت چاپی، هودی کاستوم یا لانگ اسلیو طرح‌دار. ثبت شماره تماس رایگان است؛ هزینه لباس و چاپ پس از بررسی فایل و جزئیات سفارش اعلام می‌شود.</p><h2>سفارش تیشرت چاپی و هودی اختصاصی چطور پیگیری می‌شود؟</h2><p>شماره‌ات را در فرم بالا وارد کن تا با تو تماس بگیریم، یا از دکمه واتساپ همان صفحه وارد گفت‌وگو شو. طرح، رنگ، سایز، تعداد و محل چاپ را توضیح بده تا درباره امکان اجرا و قیمت هماهنگ کنیم.</p><p>برای طرح آماده، <a href="/printed-tshirts">خرید تیشرت چاپی</a> و <a href="/printed-hoodies">خرید هودی چاپی</a> را ببین. برای سفارش گروهی یا تعداد بالا، <a href="/wholesale">فروش عمده پوشاک چاپی</a> مسیر مناسب‌تری است.</p></section>
