@page "/size-guide"

<PageTitle>جدول سایزبندی | پاپی</PageTitle>

<div style="max-width:720px; margin:48px auto">
    <div class="card-box">
        <h2 style="margin-top:0">📏 جدول سایزبندی تیشرت</h2>
        <table class="table-papey" style="margin-top:16px">
            <thead><tr><th>سایز</th><th>عرض سینه (cm)</th><th>قد (cm)</th><th>آستین (cm)</th></tr></thead>
            <tbody>
                <tr><td><strong>S</strong></td><td>@Fa(48)</td><td>@Fa(66)</td><td>@Fa(20)</td></tr>
                <tr><td><strong>M</strong></td><td>@Fa(51)</td><td>@Fa(69)</td><td>@Fa(21)</td></tr>
                <tr><td><strong>L</strong></td><td>@Fa(54)</td><td>@Fa(72)</td><td>@Fa(22)</td></tr>
                <tr><td><strong>XL</strong></td><td>@Fa(57)</td><td>@Fa(75)</td><td>@Fa(23)</td></tr>
                <tr><td><strong>XXL</strong></td><td>@Fa(60)</td><td>@Fa(78)</td><td>@Fa(24)</td></tr>
            </tbody>
        </table>
        <p style="color:var(--papey-muted); font-size:0.85rem; margin-top:12px">مقادیر ممکن است ±۲ سانتی‌متر خطا داشته باشند.</p>
    </div>
</div>

@code {
    private static string Fa(int n) => PersianHelpers.ToPersianDigits(n.ToString());
}
