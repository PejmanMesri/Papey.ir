@page "/cart"
@rendermode InteractiveServer
@inject CartService Cart
@inject NavigationManager Nav
@inject TaxSettingsService TaxSettings
@inject DiscountService Discounts
@inject AuthService Auth
@implements IDisposable

<PageTitle>سبد خرید | پاپی</PageTitle>

<div class="section-title"><h2>🛒 سبد خرید</h2></div>

@if (Cart.Items.Count == 0)
{
    <div class="card-box" style="text-align:center; max-width:480px; margin: 40px auto">
        <p style="font-size:3rem">🛒</p>
        <p>سبد خرید شما خالی است.</p>
        <a class="btn-papey" href="/">مشاهده محصولات</a>
    </div>
}
else
{
    <div class="checkout-layout">
        <div>
            <table class="table-papey mobile-card-table">
                <thead>
                    <tr><th>محصول</th><th>قیمت واحد</th><th>تعداد</th><th>جمع</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Cart.Items)
                    {
                        <tr>
                            <td data-label="محصول">
                                <div style="display:flex; gap:12px; align-items:center">
                                    <img src="@item.ImageUrl" style="width:60px; height:60px; border-radius:8px; object-fit:cover" />
                                    <div>
                                        <strong>@item.ProductName</strong>
                                        <div style="font-size:0.8rem; color:var(--papey-muted)">
                                            رنگ: @item.Color <span class="color-dot" style="width:14px;height:14px;background:@item.ColorHex; cursor:default"></span>
                                            | سایز: @item.Size
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="قیمت واحد">@item.UnitPrice.ToToman()</td>
                            <td data-label="تعداد">
                                <div class="qty-box" style="margin:0">
                                    <button @onclick="() => Cart.SetQuantity(item.ProductVariantId, item.Quantity + 1)">+</button>
                                    <span>@PersianHelpers.ToPersianDigits(item.Quantity.ToString())</span>
                                    <button @onclick="() => Cart.SetQuantity(item.ProductVariantId, item.Quantity - 1)">−</button>
                                </div>
                            </td>
                            <td data-label="جمع"><strong>@item.LineTotal.ToToman()</strong></td>
                            <td data-label="عملیات"><button class="btn-papey btn-danger-papey btn-sm" @onclick="() => Cart.Remove(item.ProductVariantId)">✕</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-box" style="height:fit-content">
            <h3 style="margin-top:0">خلاصه سفارش</h3>
            <form @onsubmit="ApplyVoucher" @onsubmit:preventDefault><label class="form-label" for="voucher-code">کد تخفیف</label><div style="display:flex;gap:8px"><input id="voucher-code" class="form-input" @bind="_voucher" maxlength="40" dir="ltr" /><button class="btn-papey" type="submit">اعمال</button></div></form>
            @if (!string.IsNullOrEmpty(Cart.VoucherCode)) { <button class="btn-papey btn-outline btn-sm" @onclick="RemoveVoucher">حذف کد</button> }

            <div style="display:flex; justify-content:space-between; margin:12px 0">
                <span>جمع کالاها:</span><strong>@Cart.Total.ToToman()</strong>
            </div>
            @if (_discount.StoreAmount > 0) { <div class="tax-summary-row"><span>تخفیف فروشگاه (@PersianHelpers.ToPersianDigits(_discount.StorePercent.ToString())٪)</span><strong>−@_discount.StoreAmount.ToToman()</strong></div> }
            @if (_discount.VoucherAmount > 0) { <div class="tax-summary-row"><span>کد تخفیف @_discount.Code</span><strong>−@_discount.VoucherAmount.ToToman()</strong></div> }
            @if (_discount.Error is not null) { <p role="alert">@_discount.Error</p> }
            <div class="tax-summary-row"><span>@OrderTax.Label(_taxEnabled)</span><strong>@TaxAmount.ToToman()</strong></div>
            <div class="alert-papey alert-info" style="font-size:0.8rem; font-weight:500">
                🚚 تمام سفارش‌ها به صورت پس‌پرداخت توسط تیپاکس ارسال می‌شوند
            </div>
            <hr style="border-color:var(--papey-border)" />
            <div style="display:flex; justify-content:space-between; font-size:1.15rem; font-weight:900; margin:16px 0">
                <span>مبلغ قابل پرداخت:</span>
                <span>@GrandTotal.ToToman()</span>
            </div>
            <AuthorizeView>
                <Authorized>
                    <button class="btn-papey" style="width:100%" @onclick='() => Nav.NavigateTo("/checkout")'>
                        ادامه فرآیند خرید ←
                    </button>
                </Authorized>
                <NotAuthorized>
                    <div class="alert-papey alert-info" style="font-size:0.85rem; font-weight:500">
                        برای تکمیل خرید ابتدا وارد حساب کاربری خود شوید.
                    </div>
                    <a class="btn-papey" style="width:100%" href="/login?returnUrl=/checkout">🔑 ورود / ثبت‌نام و ادامه خرید</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
}

@code {
    private DiscountQuote _discount = new(0,0,null,0,0);
    private string _voucher="";
    private async Task ApplyVoucher() { await Cart.SetVoucherAsync(_voucher); await RefreshDiscount(); }
    private async Task RemoveVoucher() { _voucher=""; await Cart.SetVoucherAsync(null); await RefreshDiscount(); }
    private async Task RefreshDiscount() { _discount=await Discounts.QuoteAsync(Cart.Total,Cart.VoucherCode,Auth.CurrentUserId); }
    private void CartChanged()=>_ = InvokeAsync(async()=>{await RefreshDiscount();StateHasChanged();});
    private bool _taxEnabled;
    private decimal TaxAmount => OrderTax.Calculate(Cart.Total-_discount.Total, _taxEnabled);
    private decimal GrandTotal => Cart.Total - _discount.Total + TaxAmount;
    private void OnTaxChanged() => _ = InvokeAsync(async () => { _taxEnabled = await TaxSettings.ReadAsync(); await RefreshDiscount(); StateHasChanged(); });

    protected override async Task OnInitializedAsync()
    {
        Cart.OnChange += CartChanged;
        TaxSettings.Changed += OnTaxChanged;
        _taxEnabled = await TaxSettings.ReadAsync();
        await Cart.LoadAsync(); _voucher=Cart.VoucherCode??""; await RefreshDiscount();
    }

    public void Dispose() { Cart.OnChange -= CartChanged; TaxSettings.Changed -= OnTaxChanged; }
}
