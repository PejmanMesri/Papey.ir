@page "/checkout"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CartService Cart
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthService Auth
@inject ZarinpalService Zarinpal
@inject NavigationManager Nav
@inject TaxSettingsService TaxSettings

<PageTitle>تکمیل خرید | پاپی</PageTitle>

<div class="section-title"><h2>📦 تکمیل خرید و پرداخت</h2></div>

@if (Cart.Items.Count == 0)
{
    <div class="card-box" style="text-align:center; max-width:480px; margin: 40px auto">
        <p>سبد خرید شما خالی است.</p>
        <a class="btn-papey" href="/">مشاهده محصولات</a>
    </div>
}
else
{
    <div class="checkout-layout">
        <div class="card-box">
            <h3 style="margin-top:0">اطلاعات گیرنده و آدرس</h3>

            @if (_savedAddresses.Count > 0)
            {
                <div class="form-group">
                    <label class="form-label">آدرس‌های ذخیره‌شده:</label>
                    <select class="form-input" @onchange="OnAddressSelected">
                        <option value="">— انتخاب آدرس ذخیره‌شده —</option>
                        @foreach (var a in _savedAddresses)
                        {
                            <option value="@a.Id">@a.Title — @a.City، @a.FullAddress</option>
                        }
                    </select>
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="SubmitOrder" FormName="checkout-form">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">نام و نام خانوادگی گیرنده *</label>
                        <InputText class="form-input" @bind-Value="_model.CustomerName" />
                        <ValidationMessage For="() => _model.CustomerName" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">شماره موبایل *</label>
                        <InputText class="form-input" @bind-Value="_model.CustomerPhone" placeholder="09xxxxxxxxx" />
                        <ValidationMessage For="() => _model.CustomerPhone" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">استان *</label>
                        <InputText class="form-input" @bind-Value="_model.Province" />
                        <ValidationMessage For="() => _model.Province" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">شهر *</label>
                        <InputText class="form-input" @bind-Value="_model.City" />
                        <ValidationMessage For="() => _model.City" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">آدرس کامل *</label>
                    <InputTextArea class="form-input" rows="3" @bind-Value="_model.FullAddress" />
                    <ValidationMessage For="() => _model.FullAddress" />
                </div>
                <div class="form-group" style="max-width:220px">
                    <label class="form-label">کد پستی</label>
                    <InputText class="form-input" @bind-Value="_model.PostalCode" />
                </div>
                <p style="font-size:0.8rem; color:var(--papey-muted)">📌 این آدرس به‌طور خودکار در حساب کاربری شما ذخیره می‌شود.</p>
                @if (_error is not null)
                {
                    <div class="alert-papey alert-danger">@_error</div>
                }
                <button class="btn-papey" style="width:100%" disabled="@_processing">
                    @(_processing ? "در حال اتصال به درگاه..." : "💳 پرداخت با زرین‌پال")
                </button>
            </EditForm>
        </div>
        <div class="card-box" style="height:fit-content">
            <h3 style="margin-top:0">سفارش شما</h3>
            @foreach (var item in Cart.Items.OrderBy(i => i.ProductId).ThenBy(i => i.ProductVariantId))
            {
                <div style="display:flex; justify-content:space-between; font-size:0.85rem; margin:8px 0">
                    <span>@item.ProductName (@item.Size / @item.Color) × @PersianHelpers.ToPersianDigits(item.Quantity.ToString())</span>
                    <span>@item.LineTotal.ToToman()</span>
                </div>
            }
            <hr style="border-color:var(--papey-border)" />
            <div style="display:flex; justify-content:space-between; margin:8px 0">
                <span>جمع کالاها:</span><span>@Cart.Total.ToToman()</span>
            </div>
            <div class="tax-summary-row"><span>@OrderTax.Label(_taxEnabled)</span><strong>@_tax.ToToman()</strong></div>
            <div class="alert-papey alert-info" style="font-size:0.85rem; font-weight:500; margin:12px 0">
                🚚 تمام سفارش‌ها به صورت پس‌پرداخت توسط تیپاکس ارسال می‌شوند
            </div>
            <div style="display:flex; justify-content:space-between; font-size:1.1rem; font-weight:900; margin:16px 0">
                <span>قابل پرداخت:</span><span>@_grand.ToToman()</span>
            </div>
        </div>
    </div>
}

@code {
    private CheckoutModel _model = new();
    private List<Address> _savedAddresses = new();
    private string? _error;
    private bool _processing;
    // Shipping is pay-on-delivery via Tipax — charged by the courier, not the shop
    private decimal _shipping => 0;
    private bool _taxEnabled;
    private decimal _tax => OrderTax.Calculate(Cart.Total, _taxEnabled);
    private decimal _grand => Cart.Total + _tax;

    public class CheckoutModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "نام گیرنده الزامی است")]
        public string CustomerName { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "شماره موبایل الزامی است")]
        [System.ComponentModel.DataAnnotations.RegularExpression(@"^09\d{9}$", ErrorMessage = "شماره موبایل معتبر وارد کنید")]
        public string CustomerPhone { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "استان الزامی است")]
        public string Province { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "شهر الزامی است")]
        public string City { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "آدرس کامل الزامی است")]
        public string FullAddress { get; set; } = "";
        public string? PostalCode { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await Cart.LoadAsync();
        _taxEnabled = await TaxSettings.ReadAsync();
        if (Auth.CurrentUserId is { } uid)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _savedAddresses = await db.Addresses.Where(a => a.UserId == uid).ToListAsync();
            var user = await db.Users.FindAsync(uid);
            if (user is not null)
            {
                _model.CustomerName = user.FullName ?? "";
                _model.CustomerPhone = user.Phone ?? "";
            }
            var def = _savedAddresses.FirstOrDefault(a => a.IsDefault) ?? _savedAddresses.FirstOrDefault();
            if (def is not null) FillFrom(def);
        }
    }

    private void OnAddressSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var a = _savedAddresses.FirstOrDefault(x => x.Id == id);
            if (a is not null) FillFrom(a);
        }
    }

    private void FillFrom(Address a)
    {
        _model.CustomerName = a.ReceiverName;
        _model.CustomerPhone = a.ReceiverPhone;
        _model.Province = a.Province;
        _model.City = a.City;
        _model.FullAddress = a.FullAddress;
        _model.PostalCode = a.PostalCode;
    }

    private async Task SubmitOrder()
    {
        if (_processing) return;
        var acceptedTaxEnabled = _taxEnabled;
        _processing = true; _error = null;
        try
        {
            if (!Zarinpal.IsConfigured) { _error = "درگاه پرداخت هنوز فعال نشده است. با پشتیبانی تماس بگیرید."; _processing = false; return; }
            if (Cart.Items.Count == 0 || Auth.CurrentUserId is null) { _error = "سبد خرید یا نشست شما معتبر نیست؛ صفحه را تازه کنید."; _processing = false; return; }
            await using var db = await DbFactory.CreateDbContextAsync();

            await using var transaction = await db.Database.BeginTransactionAsync();

            var currentTaxEnabled = await TaxSettingsService.ReadForOrderAsync(db);
            if (currentTaxEnabled != acceptedTaxEnabled)
            {
                _taxEnabled = currentTaxEnabled;
                _error = "تنظیم مالیات تغییر کرده است؛ مبلغ جدید سفارش را بررسی کنید و دوباره پرداخت را بزنید.";
                _processing = false;
                return;
            }
            // Validate availability and reserve only limited stock in the order transaction.
            var order = new Order
            {
                OrderNumber = $"PY-{DateTime.UtcNow:yyyyMMdd}-{Random.Shared.Next(10000, 99999)}",
                UserId = Auth.CurrentUserId,
                CustomerName = _model.CustomerName,
                CustomerPhone = _model.CustomerPhone,
                Province = _model.Province,
                City = _model.City,
                FullAddress = _model.FullAddress,
                PostalCode = _model.PostalCode,
                TotalAmount = Cart.Total,
                ShippingCost = _shipping,
                GrandTotal = _grand,
                Status = OrderStatus.Pending
            };
            foreach (var item in Cart.Items.OrderBy(i => i.ProductId).ThenBy(i => i.ProductVariantId))
            {
                var variant = await ProductInventory.ReserveAsync(db, item.ProductVariantId, item.Quantity);
                if (variant is null)
                {
                    _error = $"موجودی «{item.ProductName}» کافی نیست.";
                    _processing = false;
                    return;
                }
                if (variant.EffectivePrice != item.UnitPrice)
                {
                    _error = "قیمت یکی از محصولات تغییر کرده است؛ به سبد خرید برگردید و مبلغ جدید را بررسی کنید.";
                    _processing = false; return;
                }
                order.Items.Add(new OrderItem
                {
                    ProductId = item.ProductId,
                    ProductVariantId = item.ProductVariantId,
                    ProductName = item.ProductName,
                    Color = item.Color,
                    Size = item.Size,
                    UnitPrice = item.UnitPrice,
                    Quantity = item.Quantity,
                    LineTotal = item.LineTotal
                });
            }
            OrderTax.Apply(order, currentTaxEnabled);
            db.Orders.Add(order);

            // Always save the address to the user's account
            if (Auth.CurrentUserId is { } uid)
            {
                var exists = _savedAddresses.Any(a =>
                    a.FullAddress == _model.FullAddress && a.City == _model.City && a.ReceiverPhone == _model.CustomerPhone);
                if (!exists)
                {
                    db.Addresses.Add(new Address
                    {
                        UserId = uid,
                        Title = $"{_model.City} - {_model.CustomerName}",
                        ReceiverName = _model.CustomerName,
                        ReceiverPhone = _model.CustomerPhone,
                        Province = _model.Province,
                        City = _model.City,
                        FullAddress = _model.FullAddress,
                        PostalCode = _model.PostalCode,
                        IsDefault = !_savedAddresses.Any()
                    });
                }
            }
            await db.SaveChangesAsync();

            await transaction.CommitAsync();

            // Request from the configured gateway, explicitly in rials.
            var pay = await Zarinpal.RequestPaymentAsync(
                ZarinpalService.ToRials(order.GrandTotal),
                $"سفارش {order.OrderNumber} فروشگاه پاپی",
                order.CustomerPhone);

            if (!pay.Success)
            {
                order.Status = OrderStatus.PaymentFailed;
                await db.SaveChangesAsync();
                _error = $"خطا در اتصال به درگاه پرداخت: {pay.Error}";
                _processing = false;
                return;
            }

            order.PaymentAuthority = pay.Authority;
            await db.SaveChangesAsync();

            Nav.NavigateTo(pay.PaymentUrl!, forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = "خطایی رخ داد: " + ex.Message;
            _processing = false;
        }
    }
}
