@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>داشبورد | پنل مدیریت پاپی</PageTitle>

<h1 style="margin-top:0">📊 داشبورد</h1>

<div class="stat-grid">
    <div class="stat-card">🧾 کل سفارش‌ها<div class="num">@Fa(_totalOrders)</div></div>
    <div class="stat-card">💰 فروش (پرداخت‌شده)<div class="num">@_revenue.ToToman()</div></div>
    <div class="stat-card">👕 تعداد محصولات<div class="num">@Fa(_totalProducts)</div></div>
    <div class="stat-card">👤 کاربران<div class="num">@Fa(_totalUsers)</div></div>
</div>

<h3>آخرین سفارش‌ها</h3>
<table class="table-papey">
    <thead><tr><th>شماره</th><th>مشتری</th><th>مبلغ</th><th>وضعیت</th><th>تاریخ</th></tr></thead>
    <tbody>
        @foreach (var o in _latest)
        {
            <tr>
                <td>@o.OrderNumber</td>
                <td>@o.CustomerName<br /><small style="color:var(--papey-muted)">@o.CustomerPhone</small></td>
                <td>@o.GrandTotal.ToToman()</td>
                <td><span class="status-chip status-@o.Status">@PersianHelpers.StatusLabel(o.Status)</span></td>
                <td>@PersianHelpers.ToPersianDigits(o.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm"))</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private int _totalOrders, _totalProducts, _totalUsers;
    private decimal _revenue;
    private List<Order> _latest = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _totalOrders = await db.Orders.CountAsync();
        _totalProducts = await db.Products.CountAsync();
        _totalUsers = await db.Users.CountAsync();
        _revenue = await db.Orders.Where(o => o.Status == OrderStatus.Paid).SumAsync(o => (decimal?)o.GrandTotal) ?? 0;
        _latest = await db.Orders.OrderByDescending(o => o.CreatedAt).Take(8).ToListAsync();
    }

    private static string Fa(int n) => PersianHelpers.ToPersianDigits(n.ToString());
}
