@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>داشبورد | پنل مدیریت پاپی</PageTitle>

<h1 style="margin-top:0">📊 داشبورد</h1>

<div class="stat-grid">
    <div class="stat-card">💰 فروش امروز<div class="num">@_todaySales.ToToman()</div></div>
    <div class="stat-card">🧾 سفارش‌های امروز<div class="num">@Fa(_todayOrders)</div></div>
    <div class="stat-card">📅 فروش ۳۰ روز اخیر<div class="num">@_monthSales.ToToman()</div></div>
    <div class="stat-card">👤 کاربران<div class="num">@Fa(_totalUsers)</div></div>
</div>

<h3>فروش روزانه (۳۰ روز اخیر)</h3>
<div class="card-box" style="margin-bottom:28px">
    <div style="display:flex; align-items:flex-end; gap:4px; height:160px">
        @foreach (var d in _daily)
        {
            var h = _maxDaily > 0 ? (int)(d.Amount / _maxDaily * 140) : 0;
            <div title="@PersianHelpers.ToPersianDigits(d.Date.ToString("MM/dd")): @d.Amount.ToToman()"
                 style="flex:1; background:var(--papey-accent); border-radius:4px 4px 0 0; height:@(Math.Max(h, 2))px; min-width:8px"></div>
        }
    </div>
    <div style="display:flex; justify-content:space-between; font-size:0.7rem; color:var(--papey-muted); margin-top:6px">
        @if (_daily.Count > 0)
        {
            <span>@PersianHelpers.ToPersianDigits(_daily.First().Date.ToString("yyyy/MM/dd"))</span>
            <span>@PersianHelpers.ToPersianDigits(_daily.Last().Date.ToString("yyyy/MM/dd"))</span>
        }
    </div>
</div>

<h3>آخرین سفارش‌ها</h3>
<table class="table-papey">
    <thead><tr><th>شماره</th><th>مشتری</th><th>مبلغ</th><th>وضعیت</th><th>تاریخ</th></tr></thead>
    <tbody>
        @foreach (var o in _latest)
        {
            <tr>
                <td>@o.OrderNumber</td>
                <td>@o.CustomerName<br /><small style="color:var(--papey-muted)">@o.CustomerPhone</small></td>
                <td>@o.GrandTotal.ToToman()</td>
                <td><span class="status-chip status-@o.Status">@PersianHelpers.StatusLabel(o.Status)</span></td>
                <td>@PersianHelpers.ToPersianDigits(o.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm"))</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private int _totalUsers, _todayOrders;
    private decimal _todaySales, _monthSales, _maxDaily;
    private List<(DateTime Date, decimal Amount)> _daily = new();
    private List<Order> _latest = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _totalUsers = await db.Users.CountAsync();

        var today = DateTime.UtcNow.Date;
        var paid = await db.Orders
            .Where(o => o.Status == OrderStatus.Paid)
            .Select(o => new { o.GrandTotal, o.CreatedAt })
            .ToListAsync();

        _todaySales = paid.Where(o => o.CreatedAt >= today).Sum(o => o.GrandTotal);
        _todayOrders = paid.Count(o => o.CreatedAt >= today);
        _monthSales = paid.Where(o => o.CreatedAt >= today.AddDays(-30)).Sum(o => o.GrandTotal);

        _daily = Enumerable.Range(0, 30)
            .Select(i => (Date: today.AddDays(-29 + i),
                Amount: paid.Where(o => o.CreatedAt.Date == today.AddDays(-29 + i)).Sum(o => o.GrandTotal)))
            .ToList();
        _maxDaily = _daily.Max(d => d.Amount);

        _latest = await db.Orders.OrderByDescending(o => o.CreatedAt).Take(8).ToListAsync();
    }

    private static string Fa(int n) => PersianHelpers.ToPersianDigits(n.ToString());
}
