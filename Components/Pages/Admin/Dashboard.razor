@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthService Auth

<PageTitle>داشبورد | پنل مدیریت پاپی</PageTitle>

@if (_seller)
{
    <h1>میز کار فروشنده</h1><p>سفارش‌ها را پیگیری کنید، درخواست‌های اختصاصی را بررسی کنید و به مشتریان پاسخ دهید.</p>
    <div class="stat-grid"><a class="stat-card" href="/admin/sales">آماده‌سازی و ارسال<div class="num">@Fa(_toShip)</div></a><a class="stat-card" href="/admin/custom-designs">درخواست اختصاصی جدید<div class="num">@Fa(_custom)</div></a><a class="stat-card" href="/admin/reviews">نظرهای بدون پاسخ<div class="num">@Fa(_reviews)</div></a></div>
    <div class="seller-shortcuts"><a class="btn-papey" href="/admin/products">مدیریت محصولات</a><a class="btn-papey btn-outline" href="/admin/custom-designs">بررسی طرح‌های اختصاصی</a><a class="btn-papey btn-outline" href="/admin/reviews">پاسخ به مشتریان</a></div>
}
else
{
<h1 style="margin-top:0">📊 داشبورد</h1>

<div class="stat-grid">
    <div class="stat-card">💰 فروش امروز<div class="num">@_todaySales.ToToman()</div></div>
    <div class="stat-card">🧾 سفارش‌های امروز<div class="num">@Fa(_todayOrders)</div></div>
    <div class="stat-card">👁 بازدید امروز<div class="num">@Fa(_todayViews)</div></div>
    <div class="stat-card">📅 فروش ۳۰ روز اخیر<div class="num">@_monthSales.ToToman()</div></div>
    <div class="stat-card">👤 کاربران<div class="num">@Fa(_totalUsers)</div></div>
</div>

<h3>فروش روزانه (۳۰ روز اخیر)</h3>
<div class="card-box" style="margin-bottom:28px">
    <div style="display:flex; align-items:flex-end; gap:4px; height:160px">
        @foreach (var d in _daily)
        {
            var h = _maxDaily > 0 ? (int)(d.Amount / _maxDaily * 140) : 0;
            <div title="@PersianHelpers.ToPersianMonthDay(d.Date): @d.Amount.ToToman()"
                 style="flex:1; background:var(--papey-accent); border-radius:4px 4px 0 0; height:@(Math.Max(h, 2))px; min-width:0"></div>
        }
    </div>
    <div style="display:flex; justify-content:space-between; font-size:0.7rem; color:var(--papey-muted); margin-top:6px">
        @if (_daily.Count > 0)
        {
            <span>@PersianHelpers.ToPersianDate(_daily.First().Date)</span>
            <span>@PersianHelpers.ToPersianDate(_daily.Last().Date)</span>
        }
    </div>
</div>

<h3>بازدید روزانه (۳۰ روز اخیر)</h3>
<div class="card-box" style="margin-bottom:28px">
    <div style="display:flex; align-items:flex-end; gap:4px; height:160px">
        @foreach (var d in _dailyViews)
        {
            var h = _maxViews > 0 ? (int)((double)d.Count / _maxViews * 140) : 0;
            <div title="@PersianHelpers.ToPersianMonthDay(d.Date): @Fa(d.Count) بازدید"
                 style="flex:1; background:#1565c0; border-radius:4px 4px 0 0; height:@(Math.Max(h, 2))px; min-width:0"></div>
        }
    </div>
    <div style="display:flex; justify-content:space-between; font-size:0.7rem; color:var(--papey-muted); margin-top:6px">
        @if (_dailyViews.Count > 0)
        {
            <span>@PersianHelpers.ToPersianDate(_dailyViews.First().Date)</span>
            <span>@PersianHelpers.ToPersianDate(_dailyViews.Last().Date)</span>
        }
    </div>
</div>


}
<h3>آخرین سفارش‌ها</h3>
<div class="admin-table-scroll" role="region" aria-label="جدول اطلاعات" tabindex="0">
<table class="table-papey mobile-card-table">
    <thead><tr><th>شماره</th><th>مشتری</th><th>مبلغ</th><th>وضعیت</th><th>تاریخ</th></tr></thead>
    <tbody>
        @foreach (var o in _latest)
        {
            <tr class="row-@o.Status">
                <td data-label="شماره">@o.OrderNumber</td>
                <td data-label="مشتری">@o.CustomerName<br /><small style="color:var(--papey-muted)">@o.CustomerPhone</small></td>
                <td data-label="مبلغ">@o.GrandTotal.ToToman()</td>
                <td data-label="وضعیت"><span class="status-chip status-@o.Status">@PersianHelpers.StatusLabel(o.Status)</span></td>
                <td data-label="تاریخ">@PersianHelpers.ToPersianDateTime(o.CreatedAt)</td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    private bool _seller;
    private int _toShip, _custom, _reviews;
    private int _totalUsers, _todayOrders, _todayViews, _maxViews;
    private decimal _todaySales, _monthSales, _maxDaily;
    private List<(DateTime Date, decimal Amount)> _daily = new();
    private List<(DateTime Date, int Count)> _dailyViews = new();
    private List<Order> _latest = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _seller = Auth.CurrentPrincipal?.IsInRole("Owner") != true;
        if (_seller)
        {
            _toShip = await db.Orders.CountAsync(o => o.PaidAt != null && (o.Status == OrderStatus.Paid || o.Status == OrderStatus.Processing));
            _custom = await db.CustomDesignRequests.CountAsync(r => r.Status == CustomDesignStatus.New) + await db.CustomCallbackRequests.CountAsync(r => r.Status == CustomDesignStatus.New);
            _reviews = await db.ProductReviews.CountAsync(r => !r.IsHidden && (r.AdminReply == null || r.AdminReply == ""));
            _latest = await db.Orders.Where(o => o.PaidAt != null && o.Status != OrderStatus.Cancelled).OrderByDescending(o => o.CreatedAt).Take(8).ToListAsync();
            return;
        }
        _totalUsers = await db.Users.CountAsync();

        var today = DateTime.UtcNow.Date;
        // Paid orders (Pending/PaymentFailed/Cancelled excluded) — Cancelled never counts toward revenue
        var paid = await db.Orders
            .Where(o => o.Status != OrderStatus.Pending && o.Status != OrderStatus.PaymentFailed && o.Status != OrderStatus.Cancelled)
            .Select(o => new { o.GrandTotal, o.CreatedAt })
            .ToListAsync();

        _todaySales = paid.Where(o => o.CreatedAt >= today).Sum(o => o.GrandTotal);
        _todayOrders = paid.Count(o => o.CreatedAt >= today);
        _monthSales = paid.Where(o => o.CreatedAt >= today.AddDays(-30)).Sum(o => o.GrandTotal);

        _daily = Enumerable.Range(0, 30)
            .Select(i => (Date: today.AddDays(-29 + i),
                Amount: paid.Where(o => o.CreatedAt.Date == today.AddDays(-29 + i)).Sum(o => o.GrandTotal)))
            .ToList();
        _maxDaily = _daily.Max(d => d.Amount);

        // Daily page views
        var views = await db.PageViews
            .Where(v => v.ViewedAt >= today.AddDays(-30))
            .Select(v => v.ViewedAt)
            .ToListAsync();
        _todayViews = views.Count(v => v.Date == today);
        _dailyViews = Enumerable.Range(0, 30)
            .Select(i => (Date: today.AddDays(-29 + i), Count: views.Count(v => v.Date == today.AddDays(-29 + i))))
            .ToList();
        _maxViews = _dailyViews.Max(d => d.Count);

        _latest = await db.Orders
            .Where(o => o.Status != OrderStatus.Cancelled)
            .OrderByDescending(o => o.CreatedAt).Take(8).ToListAsync();
    }

    private static string Fa(int n) => PersianHelpers.ToPersianDigits(n.ToString());
}
