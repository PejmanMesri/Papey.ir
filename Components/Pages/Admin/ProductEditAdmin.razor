    private async Task UploadSizeGuide(InputFileChangeEventArgs e)
    {
        if (_saving || _guideUploading) return;
        _guideUploading = true;
        _guideError = null;
        try
        {
            var file = e.File;
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (extension is not (".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" or ".avif"))
                throw new InvalidOperationException();

            await using var input = file.OpenReadStream(15 * 1024 * 1024);
            _guideUpload = await DraftUploads.StageAsync(input, file.Name);
            _removeGuide = false;
        }
        catch
        {
            _guideError = "آپلود انجام نشد. یک تصویر معتبر تا ۱۵ مگابایت انتخاب کنید.";
        }
        finally { _guideUploading = false; }
    }

    private void ResetSizeGuide()
    {
        if (_saving || _guideUploading) return;
        _guideUpload = null;
        _guideError = null;
        _removeGuide = true;
        _guideInputKey++;
    }

    private const int MaxGalleryFilesPerSelection = 20;
    private const long MaxGalleryFileSize = 50 * 1024 * 1024;

    private async Task UploadMedia(InputFileChangeEventArgs e)
    {
        if (_saving || _uploading) return;
        _uploadError = null;
        if (e.FileCount > MaxGalleryFilesPerSelection)
        {
            _uploadError = $"در هر بار حداکثر {MaxGalleryFilesPerSelection} فایل انتخاب کنید.";
            return;
        }

        _uploading = true;
        var errors = new List<string>();
        try
        {
            foreach (var file in e.GetMultipleFiles(MaxGalleryFilesPerSelection))
            {
                try { await UploadGalleryFile(file); }
                catch (Exception ex) { errors.Add($"{file.Name}: {ex.Message}"); }
            }
            if (errors.Count > 0) _uploadError = "خطا در آپلود: " + string.Join(" | ", errors);
        }
        finally { _uploading = false; }
    }

    private async Task UploadGalleryFile(IBrowserFile file)
    {
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not (".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" or ".avif" or ".mp4" or ".webm"))
            throw new InvalidOperationException("فرمت فایل مجاز نیست.");
        if (file.Size > MaxGalleryFileSize)
            throw new InvalidOperationException("حجم فایل بیشتر از ۵۰ مگابایت است.");

        var isVideo = ext is ".mp4" or ".webm";
        var media = new ProductMedia { Type = isVideo ? MediaType.Video : MediaType.Image };
        await using var input = file.OpenReadStream(MaxGalleryFileSize);
        if (IsNew)
        {
            var upload = await DraftUploads.StageAsync(input, file.Name);
            media.Url = upload.PreviewUrl;
            media.DisplayOrder = _media.Count;
            _draftMedia.Add(media, upload);
            _media.Add(media);
            return;
        }

        var mediaFolder = isVideo ? "videos" : "images";
        var folder = Path.Combine("wwwroot", "uploads", mediaFolder);
        Directory.CreateDirectory(folder);
        var name = $"{Guid.NewGuid():N}{ext}";
        var path = Path.Combine(folder, name);
        await using var db = await DbFactory.CreateDbContextAsync();
        try
        {
            await using (var fs = File.Create(path))
                await input.CopyToAsync(fs);

            media.ProductId = Id;
            media.Url = $"/uploads/{mediaFolder}/{name}";
            media.Alt = _product?.Name;
            media.DisplayOrder = 1 + (await db.ProductMedia.Where(m => m.ProductId == Id)
                .MaxAsync(m => (int?)m.DisplayOrder) ?? -1);
            db.ProductMedia.Add(media);
            await db.SaveChangesAsync();
        }
        catch
        {
            try { File.Delete(path); } catch { }
            throw;
        }
        _media.Add(media);
    }

    private async Task UploadDesigns(InputFileChangeEventArgs e)
    {
        if (_saving || _designUploading) return;
        _designUploading = true;
        _designUploadError = null;
        var errors = new List<string>();
        var pending = new List<(IBrowserFile File, string StoredFileName, string ContentType)>();

        try
        {
            var folder = Path.Combine(Env.ContentRootPath, "App_Data", "product-designs");
            Directory.CreateDirectory(folder);

            foreach (var file in e.GetMultipleFiles(20))
            {
                var extension = Path.GetExtension(file.Name);
                if (!DesignContentTypes.TryGetValue(extension, out var contentType))
                {
                    errors.Add($"{file.Name}: فرمت فایل مجاز نیست.");
                    continue;
                }
                if (file.Size > 15 * 1024 * 1024)
                {
                    errors.Add($"{file.Name}: حجم فایل بیشتر از ۱۵ مگابایت است.");
                    continue;
                }

                if (IsNew)
                {
                    await using var input = file.OpenReadStream(15 * 1024 * 1024);
                    var upload = await DraftUploads.StageAsync(input, file.Name);
                    var design = new ProductDesignMedia { StoredFileName = upload.Name,
                        OriginalFileName = Path.GetFileName(file.Name), ContentType = contentType,
                        FileSize = file.Size, DisplayOrder = _designMedia.Count };
                    _designMedia.Add(design); _draftDesigns.Add(design, upload);
                    continue;
                }
                var storedFileName = $"{Guid.NewGuid():N}{extension.ToLowerInvariant()}";
                var filePath = Path.Combine(folder, storedFileName);
                await using var output = File.Create(filePath);
                await file.OpenReadStream(15 * 1024 * 1024).CopyToAsync(output);
                pending.Add((file, storedFileName, contentType));
            }

            if (pending.Count > 0)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                db.ProductDesignMedia.AddRange(pending.Select((item, index) => new ProductDesignMedia
                {
                    ProductId = Id,
                    StoredFileName = item.StoredFileName,
                    OriginalFileName = Path.GetFileName(item.File.Name),
                    ContentType = item.ContentType,
                    FileSize = item.File.Size,
                    DisplayOrder = _designMedia.Count + index
                }));
                await db.SaveChangesAsync();
                await Reload(true);
            }

            if (errors.Count > 0) _designUploadError = string.Join(" ", errors);
        }
        catch (Exception ex)
        {
            _designUploadError = "خطا در آپلود فایل طرح: " + ex.Message;
        }
        finally
        {
            _designUploading = false;
        }
    }

    private async Task MoveMedia(ProductMedia m, int dir)
    {
        if (_saving || _uploading) return;
        if (IsNew)
        {
            var index = _media.IndexOf(m); var next = index + dir;
            if (index < 0 || next < 0 || next >= _media.Count) return;
            (_media[index], _media[next]) = (_media[next], _media[index]);
            for (var n = 0; n < _media.Count; n++) _media[n].DisplayOrder = n;
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var list = await db.ProductMedia.Where(x => x.ProductId == Id).OrderBy(x => x.DisplayOrder).ToListAsync();
        var i = list.FindIndex(x => x.Id == m.Id);
        var j = i + dir;
        if (i < 0 || j < 0 || j >= list.Count) return;
        (list[i].DisplayOrder, list[j].DisplayOrder) = (list[j].DisplayOrder, list[i].DisplayOrder);
        await db.SaveChangesAsync();
        await Reload(true);
    }

    private async Task DeleteMedia(ProductMedia m)
    {
        if (_saving || _uploading) return;
        if (IsNew)
        {
            DraftUploads.Delete(_draftMedia[m]); _draftMedia.Remove(m); _media.Remove(m);
            for (var n = 0; n < _media.Count; n++) _media[n].DisplayOrder = n;
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var t = await db.ProductMedia.FindAsync(m.Id);
        if (t is not null) { db.ProductMedia.Remove(t); await db.SaveChangesAsync(); }
        try { System.IO.File.Delete(Path.Combine("wwwroot", m.Url.TrimStart('/'))); } catch { }
        await Reload(true);
    }

    private async Task DeleteDesign(ProductDesignMedia design)
    {
        if (_saving) return;
        if (IsNew)
        {
            DraftUploads.Delete(_draftDesigns[design]); _draftDesigns.Remove(design); _designMedia.Remove(design);
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var target = await db.ProductDesignMedia.FirstOrDefaultAsync(item => item.Id == design.Id && item.ProductId == Id);
        if (target is null) return;

        db.ProductDesignMedia.Remove(target);
        await db.SaveChangesAsync();
        try
        {
            var filePath = Path.Combine(Env.ContentRootPath, "App_Data", "product-designs", Path.GetFileName(target.StoredFileName));
            File.Delete(filePath);
        }
        catch { }
        await Reload(true);
    }

    private async Task SetUnlimitedStock(ChangeEventArgs e)
    {
        if (_saving || _product is null || e.Value is not bool enabled) return;
        if (IsNew) { _product.HasUnlimitedStock = enabled; return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        var product = await db.Products.FindAsync(Id);
        if (product is null) return;
        product.HasUnlimitedStock = enabled;
        await db.SaveChangesAsync();
        _product.HasUnlimitedStock = enabled;
        _variantMsg = enabled ? "✓ موجودی نامحدود فعال شد." : "✓ موجودی محدود فعال شد؛ تعداد هر ترکیب را بررسی کنید.";
    }

    private async Task ToggleVariant(Color c, Size s, bool enabled)
    {
        if (_saving) return;
        if (IsNew)
        {
            var variant = _product!.Variants.FirstOrDefault(v => v.ColorId == c.Id && v.SizeId == s.Id);
            if (variant is null && enabled) _product.Variants.Add(new ProductVariant { ColorId = c.Id,
                Color = c.Name, ColorHex = c.Hex, SizeId = s.Id, Size = s.Name, IsEnabled = true });
            else if (variant is not null) variant.IsEnabled = enabled;
            return;
        }
        _variantMsg = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.ProductVariants.FirstOrDefaultAsync(v => v.ProductId == Id && v.ColorId == c.Id && v.SizeId == s.Id);
        if (enabled && existing is null)
        {
            db.ProductVariants.Add(new ProductVariant
            {
                ProductId = Id, ColorId = c.Id, Color = c.Name, ColorHex = c.Hex,
                SizeId = s.Id, Size = s.Name, Stock = 0, IsEnabled = true
            });
        }
        else if (existing is not null)
        {
            // Retain IDs and previous quantities, including variants used by historical orders.
            existing.IsEnabled = enabled;
        }
        await db.SaveChangesAsync();
        _variantMsg = enabled ? "✓ ترکیب رنگ و سایز فعال شد." : "✓ ترکیب رنگ و سایز غیرفعال شد.";
        await Reload(true);
    }

    private async Task SetStock(Color c, Size s, string? val)
    {
        if (_saving || _product?.HasUnlimitedStock != false || !int.TryParse(val, out var stock) || stock < 0) return;
        if (IsNew)
        {
            var variant = _product.Variants.FirstOrDefault(v => v.ColorId == c.Id && v.SizeId == s.Id);
            if (variant?.IsEnabled == true) variant.Stock = stock;
            return;
        }
        _variantMsg = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        var t = await db.ProductVariants.FirstOrDefaultAsync(v => v.ProductId == Id && v.ColorId == c.Id && v.SizeId == s.Id);
        if (t is null || !t.IsEnabled) return;
        t.Stock = stock;
        _variantMsg = "✓ موجودی به‌روزرسانی شد.";
        await db.SaveChangesAsync();
        await Reload(true);
    }

    private void UpdateDraftStock(Color color, Size size, string? value)
    {
        if (!IsNew || _saving || _product is null || !int.TryParse(value, out var stock) || stock < 0) return;
        var variant = _product.Variants.FirstOrDefault(v => v.ColorId == color.Id && v.SizeId == size.Id);
        if (variant?.IsEnabled == true) variant.Stock = stock;
    }
}
