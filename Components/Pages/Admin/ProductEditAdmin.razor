@page "/admin/products/{Id:int}"
@page "/admin/products/new"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IWebHostEnvironment Env

<PageTitle>@(IsNew ? "افزودن محصول" : "ویرایش محصول") | پنل مدیریت پاپی</PageTitle>

@if (_product is null)
{
    <div class="alert-papey alert-info">محصول یافت نشد.</div>
}
else
{
    <div class="product-editor">
    <header class="editor-header">
        <div>
            <a class="editor-back" href="/admin/products">→ محصولات</a>
            <h1>@(IsNew ? "افزودن محصول جدید" : "ویرایش محصول")</h1>
            <p>@(IsNew ? "مشخصات محصول را تکمیل کنید." : _product.Name)</p>
        </div>
        <button type="button" class="btn-papey editor-save" disabled="@_saving" @onclick="SaveInfo">@(_saving ? "در حال ذخیره…" : IsNew ? "ذخیره و ادامه" : "ذخیره تغییرات")</button>
    </header>
    @if (IsNew)
    {
        <div class="alert-papey alert-info" role="status">محصول فقط با زدن «ذخیره و ادامه» ایجاد می‌شود. پس از ذخیره، تصاویر، فایل‌های طرح و موجودی را تکمیل کنید.</div>
    }
    @if (_infoError is not null) { <div class="alert-papey alert-danger" role="alert">@_infoError</div> }

    <div class="editor-overview">
        <section class="editor-card editor-details" aria-labelledby="details-title">
            <div class="editor-section-title"><span>۰۱</span><div><h2 id="details-title">مشخصات محصول</h2><p>نام، قیمت و دسته‌بندی محصول را تکمیل کنید.</p></div></div>
            <div class="editor-fields">
                <div class="editor-field editor-full">
                    <label for="edit-product-name">نام محصول <span class="required-mark">*</span></label>
                    <input id="edit-product-name" class="form-input" maxlength="200" placeholder="مثلاً تیشرت طرح تهران" @bind="_product.Name" @bind:event="oninput" />
                </div>
                <div class="editor-field">
                    <label for="edit-product-price">قیمت فروش <span class="editor-unit">تومان</span></label>
                    <input id="edit-product-price" class="form-input editor-number" type="number" min="0" step="1000" @bind="_product.Price" @bind:event="oninput" />
                </div>
                <div class="editor-field">
                    <label for="edit-product-old-price">قیمت قبل از تخفیف <span class="editor-unit">تومان</span></label>
                    <input id="edit-product-old-price" class="form-input editor-number" type="number" min="0" step="1000" placeholder="اختیاری" @bind="_product.OldPrice" @bind:event="oninput" />
                </div>
                <div class="editor-field editor-full">
                    <label for="edit-product-type">نوع محصول <span class="required-mark">*</span></label>
                    <select id="edit-product-type" class="form-input" value="@_product.ProductTypeId" @onchange="OnProductTypeChanged">
                        <option value="">نوع محصول را انتخاب کنید</option>
                        @foreach (var t in _types) { <option value="@t.Id">@t.Name</option> }
                    </select>
                </div>
                <fieldset class="editor-categories editor-full">
                    <legend>دسته‌بندی‌ها <span class="required-mark">*</span></legend>
                    @if (_product.ProductTypeId is not { } selectedTypeId)
                    {
                        <p class="editor-hint">برای دیدن دسته‌بندی‌ها، ابتدا نوع محصول را انتخاب کنید.</p>
                    }
                    else
                    {
                        <div class="editor-category-options">
                            @foreach (var category in _categories.Where(c => c.ProductTypeId == selectedTypeId).OrderBy(c => c.DisplayOrder))
                            {
                                <label class="editor-category @(_selectedCatIds.Contains(category.Id) ? "is-selected" : "")">
                                    <input type="checkbox" checked="@_selectedCatIds.Contains(category.Id)" @onchange="e => ToggleCategory(category.Id, (bool)e.Value!)" />
                                    <span>@category.Name</span>
                                </label>
                            }
                        </div>
                        <p class="editor-hint">حداقل یک دسته‌بندی انتخاب کنید.</p>
                    }
                </fieldset>
                <div class="editor-field editor-full">
                    <label for="edit-product-description">توضیحات محصول</label>
                    <textarea id="edit-product-description" class="form-input" rows="5" maxlength="2000" placeholder="درباره جنس، طرح و ویژگی‌های محصول بنویسید…" @bind="_product.Description" @bind:event="oninput"></textarea>
                </div>
            </div>
        </section>
        <aside class="editor-settings">
            <section class="editor-card" aria-labelledby="visibility-title">
                <div class="editor-section-title"><span>۰۲</span><div><h2 id="visibility-title">نمایش در فروشگاه</h2><p>وضعیت و نشان‌های محصول</p></div></div>
                <label class="editor-option"><span><strong>فعال در فروشگاه</strong><small>مشتریان می‌توانند محصول را ببینند.</small></span><input type="checkbox" @bind="_product.IsActive" /></label>
                <label class="editor-option"><span><strong>محصول جدید</strong><small>نمایش نشان «جدید» روی محصول</small></span><input type="checkbox" @bind="_product.IsNew" /></label>
                <label class="editor-option"><span><strong>محصول محبوب</strong><small>نمایش در مجموعه محصولات محبوب</small></span><input type="checkbox" @bind="_product.IsFeatured" /></label>
            </section>
            <section class="editor-card editor-hero" aria-labelledby="hero-title">
                <h2 id="hero-title">بالای صفحه اصلی</h2>
                <p class="editor-hint">تصویر اصلی محصول را در یکی از دو جایگاه صفحه اصلی نمایش دهید.</p>
                <label class="editor-field" for="home-hero-slot">جایگاه نمایش</label>
                <select id="home-hero-slot" class="form-input" @bind="_product.HomeHeroSlot">
                    <option value="">نمایش داده نشود</option>
                    <option value="1">جایگاه اول</option>
                    <option value="2">جایگاه دوم</option>
                </select>
                <p class="editor-hint">انتخاب هر جایگاه، محصول قبلی آن را جایگزین می‌کند. محصول باید فعال باشد.</p>
            </section>
            <p class="editor-save-note">پس از تکمیل این بخش‌ها، «@(IsNew ? "ذخیره و ادامه" : "ذخیره تغییرات")» را بزنید.</p>
        </aside>
    </div>

    <section class="editor-card editor-assets">
        <div class="editor-section-title"><span>۰۳</span><div><h2>تصاویر و ویدیو</h2><p>اولین تصویر، تصویر اصلی محصول است.</p></div></div>
        <p style="font-size:0.8rem; color:var(--papey-muted)">
            📐 نسبت پیشنهادی تصویر: <strong>۱:۱ (مربعی)</strong> — حداقل ۸۰۰×۸۰۰ پیکسل.
            ویدیو: MP4/WebM حداکثر ۵۰ مگابایت.
        </p>
        <label class="editor-upload"><strong>افزودن تصویر یا ویدیو</strong><span>فایل را از دستگاه خود انتخاب کنید</span><InputFile OnChange="UploadMedia" accept="image/*,video/mp4,video/webm" disabled="@(IsNew || _uploading)" /></label>
        @if (_uploading) { <p>در حال آپلود...</p> }
        @if (_uploadError is not null) { <div class="alert-papey alert-danger">@_uploadError</div> }

        <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:16px">
            @foreach (var m in _media)
            {
                <div style="width:130px; text-align:center; border:1px solid var(--papey-border); border-radius:10px; padding:8px">
                    @if (m.Type == MediaType.Video)
                    {
                        <video src="@m.Url" style="width:100%; height:110px; object-fit:cover; border-radius:8px" muted></video>
                    }
                    else
                    {
                        <img src="@m.Url" alt="@_product.Name" style="width:100%; height:110px; object-fit:cover; border-radius:8px" />
                    }
                    <div style="margin-top:6px; display:flex; justify-content:center; gap:4px">
                        <button class="btn-papey btn-sm btn-outline" @onclick="() => MoveMedia(m, -1)">→</button>
                        <button class="btn-papey btn-sm btn-outline" @onclick="() => MoveMedia(m, 1)">←</button>
                        <button class="btn-papey btn-sm btn-danger-papey" @onclick="() => DeleteMedia(m)">🗑</button>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="editor-card editor-assets">
        <div class="editor-section-title"><span>۰۴</span><div><h2>فایل‌های طرح</h2><p>فایل‌های خصوصی برای چاپ و آماده‌سازی سفارش</p></div></div>
        <p style="font-size:0.8rem; color:var(--papey-muted)">
            تصاویر اصلی طرح این محصول هستند و در فروشگاه عمومی نمایش داده نمی‌شوند. فرمت‌های JPG، PNG و WebP تا ۱۵ مگابایت قابل بارگذاری‌اند.
        </p>
        <label class="editor-upload"><strong>افزودن فایل طرح</strong><span>فقط در پنل مدیریت قابل مشاهده است</span><InputFile OnChange="UploadDesigns" multiple accept=".jpg,.jpeg,.png,.webp" disabled="@(IsNew || _designUploading)" /></label>
        @if (_designUploading) { <p>در حال آپلود فایل‌های طرح...</p> }
        @if (_designUploadError is not null) { <div class="alert-papey alert-danger">@_designUploadError</div> }

        @if (_designMedia.Count > 0)
        {
            <div style="margin-top:12px">
                <a class="btn-papey btn-sm" href="/admin/products/@Id/designs.zip">⬇ دانلود همه طرح‌ها (ZIP)</a>
            </div>
            <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:16px">
                @foreach (var design in _designMedia)
                {
                    <div style="width:150px; text-align:center; border:1px solid var(--papey-border); border-radius:10px; padding:8px">
                        <img src="/admin/products/@Id/designs/@design.Id" alt="@design.OriginalFileName" style="width:100%; height:110px; object-fit:cover; border-radius:8px" />
                        <p style="margin:6px 0; overflow-wrap:anywhere; font-size:0.72rem">@design.OriginalFileName</p>
                        <div style="display:flex; justify-content:center; gap:4px">
                            <a class="btn-papey btn-sm btn-outline" href="/admin/products/@Id/designs/@design.Id/download">⬇</a>
                            <button class="btn-papey btn-sm btn-danger-papey" @onclick="() => DeleteDesign(design)">🗑</button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="editor-card editor-stock">
        <div class="editor-section-title"><span>۰۵</span><div><h2>رنگ، سایز و موجودی</h2><p>ترکیب‌های قابل سفارش را فعال کنید.</p></div></div>
        @if (IsNew) { <p class="editor-hint">این بخش پس از ذخیره محصول فعال می‌شود.</p> }
        <fieldset class="editor-stock-fields" disabled="@IsNew">
        <label class="unlimited-stock-toggle">
            <input id="unlimited-stock" type="checkbox" checked="@_product.HasUnlimitedStock" @onchange="SetUnlimitedStock" />
            موجودی نامحدود (بدون محدودیت تعداد)
        </label>
        <p style="font-size:0.85rem; color:var(--papey-muted)">
            @(_product.HasUnlimitedStock ? "فقط ترکیب‌های رنگ و سایز قابل سفارش را تیک بزنید؛ نیازی به وارد کردن تعداد نیست." : "ترکیب‌های رنگ و سایز را فعال کنید و تعداد موجودی هر ترکیب را وارد کنید. موجودی صفر یعنی ناموجود.")
        </p>
        <div style="overflow-x:auto">
            <table class="table-papey">
                <thead>
                    <tr>
                        <th>رنگ \ سایز</th>
                        @foreach (var s in _sizes) { <th>@s.Name</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _colors)
                    {
                        <tr>
                            <td>
                                <span class="color-dot" style="background:@c.Hex; cursor:default"></span> @c.Name
                            </td>
                            @foreach (var s in _sizes)
                            {
                                var v = _product.Variants.FirstOrDefault(x => x.ColorId == c.Id && x.SizeId == s.Id);
                                <td style="white-space:nowrap">
                                    <input type="checkbox" checked="@(v?.IsEnabled == true)" aria-label="فعال بودن @c.Name / @s.Name" @onchange="e => ToggleVariant(c, s, (bool)e.Value!)" />
                                    @if (!_product.HasUnlimitedStock)
                                    {
                                        <input type="number" min="0" class="form-input" value="@(v?.Stock ?? 0)"
                                               aria-label="موجودی @c.Name / @s.Name" disabled="@(v?.IsEnabled != true)" style="width:80px"
                                               @onchange="e => SetStock(c, s, e.Value?.ToString())" />
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </fieldset>
        @if (_variantMsg is not null) { <div class="alert-papey alert-success" style="margin-top:8px">@_variantMsg</div> }
    </section>
    <p class="editor-save-note">تغییرات فایل‌ها و موجودی هنگام انجام ذخیره می‌شوند.</p>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool IsNew => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/') == "admin/products/new";
    private Product? _product;
    private List<Category> _categories = new();
    private List<Color> _colors = new();
    private List<Size> _sizes = new();
    private List<ProductTypeEntity> _types = new();
    private List<ProductMedia> _media = new();
    private List<ProductDesignMedia> _designMedia = new();
    private HashSet<int> _selectedCatIds = new();
    private string? _variantMsg, _uploadError, _designUploadError;
    private bool _uploading, _designUploading, _saving;
    private string? _infoError;
    private static readonly Dictionary<string, string> DesignContentTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        [".jpg"] = "image/jpeg",
        [".jpeg"] = "image/jpeg",
        [".png"] = "image/png",
        [".webp"] = "image/webp"
    };

    protected override async Task OnParametersSetAsync()
    {
        _infoError = null;
        _variantMsg = null;
        await Reload();
    }

    private async Task Reload(bool preserveDraft = false)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _categories = await db.Categories
            .Include(c => c.ProductType)
            .OrderBy(c => c.ProductType!.DisplayOrder)
            .ThenBy(c => c.DisplayOrder)
            .ToListAsync();
        _types = await db.ProductTypes.Where(t => t.IsActive).OrderBy(t => t.DisplayOrder).ToListAsync();
        _colors = await db.Colors.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder).ToListAsync();
        _sizes = await db.Sizes.Where(s => s.IsActive).OrderBy(s => s.DisplayOrder).ToListAsync();
        if (IsNew)
        {
            if (!preserveDraft || _product is null)
            {
                _product = new Product { ProductTypeId = _types.FirstOrDefault()?.Id };
                _selectedCatIds = new();
            }
            _media = [];
            _designMedia = [];
            return;
        }
        var fresh = await db.Products.Include(p => p.Variants).Include(p => p.ProductCategories).FirstOrDefaultAsync(p => p.Id == Id);
        if (preserveDraft && _product is not null && fresh is not null) _product.Variants = fresh.Variants;
        else
        {
            _product = fresh;
            _selectedCatIds = _product?.ProductCategories.Select(pc => pc.CategoryId).ToHashSet() ?? new();
        }
        _media = await db.ProductMedia.Where(m => m.ProductId == Id).OrderBy(m => m.DisplayOrder).ToListAsync();
        _designMedia = await db.ProductDesignMedia.Where(m => m.ProductId == Id).OrderBy(m => m.DisplayOrder).ToListAsync();
    }

    private async Task SaveInfo()
    {
        if (_saving || _product is null) return;
        _infoError = null;
        if (string.IsNullOrWhiteSpace(_product.Name) || _product.Name.Length > 200)
        { _infoError = "نام محصول را وارد کنید (حداکثر ۲۰۰ کاراکتر)."; return; }
        if (_product.Price < 0 || _product.OldPrice < 0)
        { _infoError = "قیمت محصول نمی‌تواند منفی باشد."; return; }
        _saving = true;
        try { await SaveInfoCore(); }
        catch { _infoError = "ذخیره انجام نشد. دوباره تلاش کنید."; }
        finally { _saving = false; }
    }

    private async Task SaveInfoCore()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var creating = IsNew;
        var t = creating ? new Product { Slug = "p-" + Guid.NewGuid().ToString("N") } : await db.Products.FindAsync(Id);
        if (t is null) { _infoError = "محصول یافت نشد."; return; }
        t.Name = _product!.Name.Trim(); t.Price = _product.Price; t.OldPrice = _product.OldPrice;
        t.ProductTypeId = _product.ProductTypeId;
        t.Description = _product.Description; t.IsNew = _product.IsNew;
        t.IsFeatured = _product.IsFeatured; t.IsActive = _product.IsActive;
        t.HasUnlimitedStock = _product.HasUnlimitedStock;
        t.ImageUrl = _media.OrderBy(m => m.DisplayOrder).FirstOrDefault(m => m.Type == MediaType.Image)?.Url ?? t.ImageUrl;

        var validCategoryIds = _categories
            .Where(c => c.ProductTypeId == t.ProductTypeId && _selectedCatIds.Contains(c.Id))
            .Select(c => c.Id)
            .ToHashSet();
        if (t.ProductTypeId is null || validCategoryIds.Count == 0)
        {
            _infoError = "نوع محصول و حداقل یک دسته‌بندی مرتبط را انتخاب کنید.";
            return;
        }

        // The first selected category is the product's primary category; the
        // join rows retain any additional categories under the same product type.
        var firstCat = _categories
            .Where(c => validCategoryIds.Contains(c.Id))
            .OrderBy(c => c.DisplayOrder)
            .FirstOrDefault();
        if (firstCat is not null) t.CategoryId = firstCat.Id;

        // New products and category associations are committed together only on Save.
        if (creating)
        {
            foreach (var catId in validCategoryIds)
                t.ProductCategories.Add(new ProductCategory { CategoryId = catId });
            db.Products.Add(t);
        }
        else
        {
            var existing = await db.ProductCategories.Where(pc => pc.ProductId == Id).ToListAsync();
            db.ProductCategories.RemoveRange(existing.Where(pc => !validCategoryIds.Contains(pc.CategoryId)));
            foreach (var catId in validCategoryIds)
                if (!existing.Any(pc => pc.CategoryId == catId))
                    db.ProductCategories.Add(new ProductCategory { ProductId = Id, CategoryId = catId });
        }
        if (_product.HomeHeroSlot is not (null or 1 or 2)) return;
        await using var transaction = await db.Database.BeginTransactionAsync();
        await db.Database.ExecuteSqlRawAsync("SELECT pg_advisory_xact_lock(7423901)");
        var heroSlot = _product.IsActive ? _product.HomeHeroSlot : null;
        if (heroSlot is not null)
            await db.Products.Where(p => p.Id != t.Id && p.HomeHeroSlot == heroSlot)
                .ExecuteUpdateAsync(s => s.SetProperty(p => p.HomeHeroSlot, (int?)null));
        t.HomeHeroSlot = heroSlot;
        await db.SaveChangesAsync();
        await transaction.CommitAsync();
        Nav.NavigateTo(creating ? $"/admin/products/{t.Id}" : "/admin/products");
    }

    private void ToggleCategory(int catId, bool selected)
    {
        if (selected) _selectedCatIds.Add(catId);
        else _selectedCatIds.Remove(catId);
    }

    private void OnProductTypeChanged(ChangeEventArgs args)
    {
        _product!.ProductTypeId = int.TryParse(args.Value?.ToString(), out var typeId) ? typeId : null;
        _selectedCatIds.Clear();
    }

    private async Task UploadMedia(InputFileChangeEventArgs e)
    {
        if (IsNew) return;
        _uploading = true; _uploadError = null;
        try
        {
            var file = e.File;
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            var isVideo = ext is ".mp4" or ".webm" or ".mov";
            var folder = Path.Combine("wwwroot", "uploads", isVideo ? "videos" : "images");
            Directory.CreateDirectory(folder);
            var name = $"{Guid.NewGuid():N}{ext}";
            var path = Path.Combine(folder, name);
            await using (var fs = File.Create(path))
                await file.OpenReadStream(50 * 1024 * 1024).CopyToAsync(fs);
            var url = $"/uploads/{(isVideo ? "videos" : "images")}/{name}";

            await using var db = await DbFactory.CreateDbContextAsync();
            db.ProductMedia.Add(new ProductMedia
            {
                ProductId = Id,
                Url = url,
                Type = isVideo ? MediaType.Video : MediaType.Image,
                Alt = _product?.Name,
                DisplayOrder = _media.Count
            });
            await db.SaveChangesAsync();
            await Reload(true);
        }
        catch (Exception ex) { _uploadError = "خطا در آپلود: " + ex.Message; }
        _uploading = false;
    }

    private async Task UploadDesigns(InputFileChangeEventArgs e)
    {
        if (IsNew) return;
        _designUploading = true;
        _designUploadError = null;
        var errors = new List<string>();
        var pending = new List<(IBrowserFile File, string StoredFileName, string ContentType)>();

        try
        {
            var folder = Path.Combine(Env.ContentRootPath, "App_Data", "product-designs");
            Directory.CreateDirectory(folder);

            foreach (var file in e.GetMultipleFiles(20))
            {
                var extension = Path.GetExtension(file.Name);
                if (!DesignContentTypes.TryGetValue(extension, out var contentType))
                {
                    errors.Add($"{file.Name}: فرمت فایل مجاز نیست.");
                    continue;
                }
                if (file.Size > 15 * 1024 * 1024)
                {
                    errors.Add($"{file.Name}: حجم فایل بیشتر از ۱۵ مگابایت است.");
                    continue;
                }

                var storedFileName = $"{Guid.NewGuid():N}{extension.ToLowerInvariant()}";
                var filePath = Path.Combine(folder, storedFileName);
                await using var output = File.Create(filePath);
                await file.OpenReadStream(15 * 1024 * 1024).CopyToAsync(output);
                pending.Add((file, storedFileName, contentType));
            }

            if (pending.Count > 0)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                db.ProductDesignMedia.AddRange(pending.Select((item, index) => new ProductDesignMedia
                {
                    ProductId = Id,
                    StoredFileName = item.StoredFileName,
                    OriginalFileName = Path.GetFileName(item.File.Name),
                    ContentType = item.ContentType,
                    FileSize = item.File.Size,
                    DisplayOrder = _designMedia.Count + index
                }));
                await db.SaveChangesAsync();
                await Reload(true);
            }

            if (errors.Count > 0) _designUploadError = string.Join(" ", errors);
        }
        catch (Exception ex)
        {
            _designUploadError = "خطا در آپلود فایل طرح: " + ex.Message;
        }
        finally
        {
            _designUploading = false;
        }
    }

    private async Task MoveMedia(ProductMedia m, int dir)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var list = await db.ProductMedia.Where(x => x.ProductId == Id).OrderBy(x => x.DisplayOrder).ToListAsync();
        var i = list.FindIndex(x => x.Id == m.Id);
        var j = i + dir;
        if (i < 0 || j < 0 || j >= list.Count) return;
        (list[i].DisplayOrder, list[j].DisplayOrder) = (list[j].DisplayOrder, list[i].DisplayOrder);
        await db.SaveChangesAsync();
        await Reload(true);
    }

    private async Task DeleteMedia(ProductMedia m)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var t = await db.ProductMedia.FindAsync(m.Id);
        if (t is not null) { db.ProductMedia.Remove(t); await db.SaveChangesAsync(); }
        try { System.IO.File.Delete(Path.Combine("wwwroot", m.Url.TrimStart('/'))); } catch { }
        await Reload(true);
    }

    private async Task DeleteDesign(ProductDesignMedia design)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var target = await db.ProductDesignMedia.FirstOrDefaultAsync(item => item.Id == design.Id && item.ProductId == Id);
        if (target is null) return;

        db.ProductDesignMedia.Remove(target);
        await db.SaveChangesAsync();
        try
        {
            var filePath = Path.Combine(Env.ContentRootPath, "App_Data", "product-designs", Path.GetFileName(target.StoredFileName));
            File.Delete(filePath);
        }
        catch { }
        await Reload(true);
    }

    private async Task SetUnlimitedStock(ChangeEventArgs e)
    {
        if (IsNew || _product is null || e.Value is not bool enabled) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var product = await db.Products.FindAsync(Id);
        if (product is null) return;
        product.HasUnlimitedStock = enabled;
        await db.SaveChangesAsync();
        _product.HasUnlimitedStock = enabled;
        _variantMsg = enabled ? "✓ موجودی نامحدود فعال شد." : "✓ موجودی محدود فعال شد؛ تعداد هر ترکیب را بررسی کنید.";
    }

    private async Task ToggleVariant(Color c, Size s, bool enabled)
    {
        if (IsNew) return;
        _variantMsg = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.ProductVariants.FirstOrDefaultAsync(v => v.ProductId == Id && v.ColorId == c.Id && v.SizeId == s.Id);
        if (enabled && existing is null)
        {
            db.ProductVariants.Add(new ProductVariant
            {
                ProductId = Id, ColorId = c.Id, Color = c.Name, ColorHex = c.Hex,
                SizeId = s.Id, Size = s.Name, Stock = 0, IsEnabled = true
            });
        }
        else if (existing is not null)
        {
            // Retain IDs and previous quantities, including variants used by historical orders.
            existing.IsEnabled = enabled;
        }
        await db.SaveChangesAsync();
        _variantMsg = enabled ? "✓ ترکیب رنگ و سایز فعال شد." : "✓ ترکیب رنگ و سایز غیرفعال شد.";
        await Reload(true);
    }

    private async Task SetStock(Color c, Size s, string? val)
    {
        if (IsNew || _product?.HasUnlimitedStock != false || !int.TryParse(val, out var stock) || stock < 0) return;
        _variantMsg = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        var t = await db.ProductVariants.FirstOrDefaultAsync(v => v.ProductId == Id && v.ColorId == c.Id && v.SizeId == s.Id);
        if (t is null || !t.IsEnabled) return;
        t.Stock = stock;
        _variantMsg = "✓ موجودی به‌روزرسانی شد.";
        await db.SaveChangesAsync();
        await Reload(true);
    }
}
