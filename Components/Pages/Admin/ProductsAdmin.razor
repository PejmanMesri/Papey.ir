@page "/admin/products"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IWebHostEnvironment Env

<PageTitle>محصولات | پنل مدیریت پاپی</PageTitle>

<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:24px">
    <h1 style="margin:0">👕 محصولات</h1>
    <button class="btn-papey" @onclick="AddProduct">➕ افزودن محصول جدید</button>
</div>

<div class="card-box" style="margin-bottom:20px">
    <button type="button" class="catalog-filter-toggle" aria-expanded="@_filtersOpen" @onclick="() => _filtersOpen = !_filtersOpen">☷ جستجو و فیلتر محصولات <span>@(_filtersOpen ? "بستن −" : "باز کردن +")</span></button>
    <div class="admin-filter-body @(_filtersOpen ? "is-open" : "")">
    <div class="admin-product-filters">
        <div>
            <label class="form-label" for="product-search">جستجو</label>
            <input id="product-search" class="form-input" placeholder="نام، شناسه یا آدرس محصول..." @bind="_search" @bind:event="oninput" />
        </div>
        <div>
            <label class="form-label" for="product-category">دسته‌بندی</label>
            <select id="product-category" class="form-input" @bind="_categoryId">
                <option value="">همه دسته‌بندی‌ها</option>
                @foreach (var category in _categories)
                {
                    <option value="@category.Id">@(category.ProductType is null ? category.Name : $"{category.ProductType.Name} / {category.Name}")</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="product-type">نوع محصول</label>
            <select id="product-type" class="form-input" @bind="_typeId">
                <option value="">همه انواع</option>
                @foreach (var type in _types) { <option value="@type.Id">@type.Name</option> }
            </select>
        </div>
        <div>
            <label class="form-label" for="product-active">وضعیت</label>
            <select id="product-active" class="form-input" @bind="_activeFilter">
                <option value="">همه وضعیت‌ها</option>
                <option value="active">فعال</option>
                <option value="inactive">غیرفعال</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="product-stock">موجودی</label>
            <select id="product-stock" class="form-input" @bind="_stockFilter">
                <option value="">همه</option>
                <option value="in-stock">موجود</option>
                <option value="out-of-stock">ناموجود</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="product-design">فایل طرح</label>
            <select id="product-design" class="form-input" @bind="_designFilter">
                <option value="">همه</option>
                <option value="with-design">دارای فایل طرح</option>
                <option value="without-design">بدون فایل طرح</option>
            </select>
        </div>
        <div>
            <label class="form-label">ثبت از تاریخ</label>
            <JalaliDatePicker @bind-Value="_from" Placeholder="از تاریخ (شمسی)" />
        </div>
        <div>
            <label class="form-label">ثبت تا تاریخ</label>
            <JalaliDatePicker @bind-Value="_to" Placeholder="تا تاریخ (شمسی)" />
        </div>
        <div>
            <label class="form-label" for="product-sort">مرتب‌سازی</label>
            <select id="product-sort" class="form-input" @bind="_sort">
                <option value="created-desc">تاریخ ثبت: جدیدترین</option>
                <option value="created-asc">تاریخ ثبت: قدیمی‌ترین</option>
                <option value="name">نام محصول</option>
                <option value="price-asc">قیمت: کم به زیاد</option>
                <option value="price-desc">قیمت: زیاد به کم</option>
                <option value="stock-asc">موجودی: کم به زیاد</option>
                <option value="stock-desc">موجودی: زیاد به کم</option>
            </select>
        </div>
        <button class="btn-papey btn-outline" @onclick="ClearFilters">پاک کردن فیلترها</button>
    </div>
    </div>
    <p style="font-size:0.85rem; color:var(--papey-muted); margin-bottom:0" aria-live="polite">
        نمایش @PersianHelpers.ToPersianDigits(FilteredProducts.Count.ToString()) از @PersianHelpers.ToPersianDigits(_products.Count.ToString()) محصول
    </p>
</div>

<div style="overflow-x:auto">
<table class="table-papey mobile-card-table">
    <thead><tr><th>تصویر</th><th>نام</th><th>نوع</th><th>دسته</th><th>قیمت</th><th>موجودی</th><th>فایل طرح</th><th>وضعیت</th><th>تاریخ ثبت</th><th></th></tr></thead>
    <tbody>
        @foreach (var p in FilteredProducts)
        {
            <tr>
                <td data-label="تصویر"><img src="@(p.Media.OrderBy(m => m.DisplayOrder).FirstOrDefault()?.Url ?? p.ImageUrl)" style="width:48px; height:48px; object-fit:cover; border-radius:8px" /></td>
                <td data-label="نام"><strong>@p.Name</strong></td>
                <td data-label="نوع">@(p.ProductType?.Name ?? "—")</td>
                <td data-label="دسته">
                    @p.Category.Name
                    @foreach (var extra in p.ProductCategories.Select(pc => pc.Category).Where(c => c.Id != p.CategoryId))
                    {
                        <span class="status-chip status-Processing" style="margin-right:4px">@extra.Name</span>
                    }
                </td>
                <td data-label="قیمت">@p.Price.ToToman()</td>
                <td data-label="موجودی">@(p.HasUnlimitedStock ? "نامحدود" : PersianHelpers.ToPersianDigits(p.Variants.Where(v => v.IsEnabled).Sum(v => (long)v.Stock).ToString()))</td>
                <td data-label="فایل طرح">
                    @if (p.DesignMedia.Count > 0)
                    {
                        <a class="btn-papey btn-sm btn-outline" href="/admin/products/@p.Id/designs.zip">ZIP (@PersianHelpers.ToPersianDigits(p.DesignMedia.Count.ToString()))</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td data-label="وضعیت">
                    <button class="btn-papey btn-sm @(p.IsActive ? "btn-outline" : "btn-danger-papey")" @onclick="() => ToggleActive(p)">
                        @(p.IsActive ? "فعال" : "غیرفعال")
                    </button>
                </td>
                <td data-label="تاریخ ثبت"><time datetime="@p.CreatedAt.ToString("O")">@PersianHelpers.ToPersianDateTime(p.CreatedAt)</time></td>
                <td data-label="عملیات">
                    <a class="btn-papey btn-sm" href="/admin/products/@p.Id">✏️ ویرایش</a>
                    <button class="btn-papey btn-sm btn-danger-papey" @onclick="() => Delete(p)">🗑</button>
                </td>
            </tr>
        }
        @if (FilteredProducts.Count == 0)
        {
            <tr><td colspan="10" style="text-align:center; padding:24px">محصولی مطابق فیلترها یافت نشد.</td></tr>
        }
    </tbody>
</table>
</div>

@code {
    private bool _filtersOpen;
    private List<Product> _products = new();
    private List<Category> _categories = new();
    private List<ProductTypeEntity> _types = new();
    private string _search = "", _activeFilter = "", _stockFilter = "", _designFilter = "";
    private string _sort = "created-desc";
    private int? _categoryId, _typeId;
    private DateTime? _from, _to;

    private List<Product> FilteredProducts
    {
        get
        {
            IEnumerable<Product> products = _products;
            var terms = PersianHelpers.ToEnglishDigits(_search.Trim()).Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (terms.Length > 0)
                products = products.Where(p => terms.All(term =>
                    PersianHelpers.ToEnglishDigits($"{p.Id} {p.Name} {p.Slug}").Contains(term, StringComparison.OrdinalIgnoreCase)));
            if (_categoryId is { } categoryId)
            {
                products = products.Where(p => p.CategoryId == categoryId || p.ProductCategories.Any(c => c.CategoryId == categoryId));
            }
            if (_typeId is { } typeId) products = products.Where(p => p.ProductTypeId == typeId);
            if (_activeFilter != "") products = products.Where(p => p.IsActive == (_activeFilter == "active"));
            if (_stockFilter != "") products = products.Where(p => p.Variants.Any(v => v.IsEnabled && (p.HasUnlimitedStock || v.Stock > 0)) == (_stockFilter == "in-stock"));
            if (_designFilter != "") products = products.Where(p => p.DesignMedia.Count > 0 == (_designFilter == "with-design"));
            if (_from is { } from) products = products.Where(p => PersianHelpers.ToIranTime(p.CreatedAt).Date >= from.Date);
            if (_to is { } to) products = products.Where(p => PersianHelpers.ToIranTime(p.CreatedAt).Date <= to.Date);

            var sorted = _sort switch
            {
                "created-asc" => products.OrderBy(p => p.CreatedAt),
                "name" => products.OrderBy(p => p.Name),
                "price-asc" => products.OrderBy(p => p.Price),
                "price-desc" => products.OrderByDescending(p => p.Price),
                "stock-asc" => products.OrderBy(p => p.HasUnlimitedStock ? long.MaxValue : p.Variants.Where(v => v.IsEnabled).Sum(v => (long)v.Stock)),
                "stock-desc" => products.OrderByDescending(p => p.HasUnlimitedStock ? long.MaxValue : p.Variants.Where(v => v.IsEnabled).Sum(v => (long)v.Stock)),
                _ => products.OrderByDescending(p => p.CreatedAt)
            };
            return sorted.ThenByDescending(p => p.Id).ToList();
        }
    }

    private void ClearFilters()
    {
        _search = _activeFilter = _stockFilter = _designFilter = "";
        _categoryId = _typeId = null;
        _from = _to = null;
        _sort = "created-desc";
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _categories = await db.Categories.Include(c => c.ProductType).OrderBy(c => c.ProductType!.DisplayOrder).ThenBy(c => c.DisplayOrder).ToListAsync();
        _types = await db.ProductTypes.OrderBy(t => t.DisplayOrder).ToListAsync();
        _products = await db.Products.Include(p => p.Category).ThenInclude(c => c.ProductType).Include(p => p.Variants).Include(p => p.Media).Include(p => p.DesignMedia).Include(p => p.ProductType)
            .Include(p => p.ProductCategories).ThenInclude(pc => pc.Category)
            .OrderByDescending(p => p.CreatedAt).ThenByDescending(p => p.Id).ToListAsync();
    }

    private void AddProduct() => Nav.NavigateTo("/admin/products/new");

    private async Task ToggleActive(Product p)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var t = await db.Products.FindAsync(p.Id);
        if (t is not null) { t.IsActive = !t.IsActive; await db.SaveChangesAsync(); p.IsActive = t.IsActive; }
    }

    private async Task Delete(Product p)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"محصول «{p.Name}» حذف شود؟")) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var designs = await db.ProductDesignMedia.Where(design => design.ProductId == p.Id).ToListAsync();
        db.ProductVariants.RemoveRange(db.ProductVariants.Where(v => v.ProductId == p.Id));
        db.ProductMedia.RemoveRange(db.ProductMedia.Where(m => m.ProductId == p.Id));
        db.ProductDesignMedia.RemoveRange(designs);
        var target = await db.Products.FindAsync(p.Id);
        if (target is null) return;
        db.Products.Remove(target);
        await db.SaveChangesAsync();
        foreach (var design in designs)
        {
            try
            {
                var filePath = Path.Combine(Env.ContentRootPath, "App_Data", "product-designs", Path.GetFileName(design.StoredFileName));
                File.Delete(filePath);
            }
            catch { }
        }
        _products.Remove(p);
    }
}
