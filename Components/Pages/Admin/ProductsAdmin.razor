@page "/admin/products"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>محصولات | پنل مدیریت پاپی</PageTitle>

<h1 style="margin-top:0">👕 محصولات</h1>

<div class="card-box" style="margin-bottom:24px">
    <h4 style="margin-top:0">افزودن محصول جدید</h4>
    <EditForm Model="_new" OnValidSubmit="AddProduct" FormName="add-product">
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:12px">
            <div><label class="form-label">نام *</label><InputText class="form-input" @bind-Value="_new.Name" required /></div>
            <div><label class="form-label">قیمت (تومان) *</label><InputNumber class="form-input" @bind-Value="_new.Price" /></div>
            <div>
                <label class="form-label">دسته‌بندی</label>
                <InputSelect class="form-input" @bind-Value="_new.CategoryId">
                    @foreach (var c in _categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </InputSelect>
            </div>
            <div><label class="form-label">آدرس تصویر</label><InputText class="form-input" @bind-Value="_new.ImageUrl" /></div>
            <div><label class="form-label">توضیح</label><InputText class="form-input" @bind-Value="_new.Description" /></div>
            <div style="display:flex; align-items:end"><button class="btn-papey" type="submit">➕ افزودن</button></div>
        </div>
    </EditForm>
</div>

<table class="table-papey">
    <thead><tr><th>تصویر</th><th>نام</th><th>دسته</th><th>قیمت</th><th>موجودی</th><th>وضعیت</th><th></th></tr></thead>
    <tbody>
        @foreach (var p in _products)
        {
            <tr>
                <td><img src="@p.ImageUrl" style="width:48px; height:48px; object-fit:cover; border-radius:8px" /></td>
                <td><strong>@p.Name</strong></td>
                <td>@p.Category.Name</td>
                <td>@p.Price.ToToman()</td>
                <td>@PersianHelpers.ToPersianDigits(p.Variants.Sum(v => v.Stock).ToString())</td>
                <td>
                    <button class="btn-papey btn-sm @(p.IsActive ? "btn-outline" : "btn-danger-papey")" @onclick="() => ToggleActive(p)">
                        @(p.IsActive ? "فعال" : "غیرفعال")
                    </button>
                </td>
                <td><button class="btn-papey btn-sm btn-danger-papey" @onclick="() => Delete(p)">🗑</button></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Product> _products = new();
    private List<Category> _categories = new();
    private Product _new = new() { Price = 1000000 };

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _categories = await db.Categories.OrderBy(c => c.DisplayOrder).ToListAsync();
        _products = await db.Products.Include(p => p.Category).Include(p => p.Variants).ToListAsync();
        if (_categories.Count > 0) _new.CategoryId = _categories[0].Id;
    }

    private async Task AddProduct()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _new.Slug = "p-" + Guid.NewGuid().ToString("N")[..8];
        _new.ImageUrl ??= "/img/products/pinterest-minimal.svg";
        db.Products.Add(_new);
        await db.SaveChangesAsync();
        // default variants
        foreach (var (cname, hex) in new[] { ("مشکی", "#212529"), ("سفید", "#f8f9fa") })
            foreach (var size in new[] { "M", "L", "XL" })
                db.ProductVariants.Add(new ProductVariant { ProductId = _new.Id, Color = cname, ColorHex = hex, Size = size, Stock = 5 });
        await db.SaveChangesAsync();
        await OnInitializedAsync();
        _new = new Product { Price = 1000000, CategoryId = _categories.FirstOrDefault()?.Id ?? 0 };
    }

    private async Task ToggleActive(Product p)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var t = await db.Products.FindAsync(p.Id);
        if (t is not null) { t.IsActive = !t.IsActive; await db.SaveChangesAsync(); p.IsActive = t.IsActive; }
    }

    private async Task Delete(Product p)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.ProductVariants.RemoveRange(db.ProductVariants.Where(v => v.ProductId == p.Id));
        db.Products.Remove(await db.Products.FindAsync(p.Id)!);
        await db.SaveChangesAsync();
        _products.Remove(p);
    }
}
