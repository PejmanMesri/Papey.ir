@page "/admin/product-types"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>انواع محصول | پنل مدیریت پاپی</PageTitle>

<h1 style="margin-top:0">🏷 انواع محصول</h1>

<div class="card-box" style="max-width:640px">
    <div style="display:flex; gap:12px; align-items:end; margin-bottom:16px; flex-wrap:wrap">
        <div><label class="form-label">نام نوع</label><input class="form-input" @bind="_newName" placeholder="مثلاً شلوار" /></div>
        <div><label class="form-label">آیکن فیلتر</label><input class="form-input" @bind="_newIcon" maxlength="64" placeholder="اختیاری؛ آیکن لباس خودکار است" /></div>
        <button class="btn-papey" @onclick="Add">➕ افزودن</button>
    </div>
    <table class="table-papey mobile-card-table">
        <thead><tr><th>نام</th><th>آیکن فیلتر</th><th>محصولات</th><th>ترتیب</th><th>وضعیت</th><th></th></tr></thead>
        <tbody>
            @foreach (var t in _types)
            {
                <tr>
                    <td data-label="نام">
                        @if (_editId == t.Id)
                        {
                            <input class="form-input" style="width:110px" @bind="_editName" />
                        }
                        else { <strong>@t.Name</strong> }
                    </td>
                    <td data-label="آیکن فیلتر">
                        @if (_editId == t.Id)
                        {
                            <input class="form-input" style="width:110px" maxlength="64" @bind="_editIcon" />
                        }
                        else
                        {
                            <span style="font-size:1.35rem"><ProductTypeSymbol TypeName="@t.Name" Value="@t.FilterIcon" /></span>
                        }
                    </td>
                    <td data-label="محصولات">@PersianHelpers.ToPersianDigits(_productCounts.GetValueOrDefault(t.Id, 0).ToString())</td>
                    <td data-label="ترتیب">
                        <button class="btn-papey btn-sm btn-outline" @onclick="() => Move(t, -1)">↑</button>
                        <button class="btn-papey btn-sm btn-outline" @onclick="() => Move(t, 1)">↓</button>
                    </td>
                    <td data-label="وضعیت">
                        <button class="btn-papey btn-sm @(t.IsActive ? "btn-outline" : "btn-danger-papey")" @onclick="() => Toggle(t)">
                            @(t.IsActive ? "فعال" : "غیرفعال")
                        </button>
                    </td>
                    <td data-label="عملیات">
                        @if (_editId == t.Id)
                        {
                            <button class="btn-papey btn-sm" @onclick="() => SaveEdit(t)">✓</button>
                        }
                        else
                        {
                            <button class="btn-papey btn-sm btn-outline" @onclick="() => { _editId = t.Id; _editName = t.Name; _editIcon = t.FilterIcon ?? string.Empty; }">✏️</button>
                        }
                        <button type="button" class="btn-papey btn-sm btn-danger-papey" disabled="@(_deleting || _productCounts.GetValueOrDefault(t.Id, 0) > 0)" title="@(_productCounts.GetValueOrDefault(t.Id, 0) > 0 ? "نوع لباس دارای محصول قابل حذف نیست" : "حذف نوع لباس")" @onclick="() => { _deleteId = t.Id; _msg = null; }">حذف</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (_deleteId is { } deleteId && _types.FirstOrDefault(t => t.Id == deleteId) is { } pending)
    {
        <div class="alert-papey alert-info" role="alert">
            <p>نوع لباس «@pending.Name» حذف شود؟ دسته‌بندی‌های آن حفظ می‌شوند و می‌توانید آن‌ها را به نوع دیگری اختصاص دهید.</p>
            <button type="button" class="btn-papey btn-sm btn-danger-papey" disabled="@_deleting" @onclick="ConfirmDelete">@(_deleting ? "در حال حذف…" : "تأیید حذف")</button>
            <button type="button" class="btn-papey btn-sm btn-outline" disabled="@_deleting" @onclick="() => _deleteId = null">انصراف</button>
        </div>
    }
    @if (_msg is not null) { <div class="alert-papey @(_msgSuccess ? "alert-success" : "alert-danger")" role="status">@_msg</div> }
</div>

@code {
    private List<ProductTypeEntity> _types = new();
    private Dictionary<int, int> _productCounts = new();
    private string _newName = "", _newIcon = "";
    private int? _editId;
    private string _editName = "", _editIcon = "";
    private string? _msg;
    private int? _deleteId;
    private bool _deleting, _msgSuccess;

    private async Task ConfirmDelete()
    {
        if (_deleting || _deleteId is not { } id) return;
        _deleting = true; _msgSuccess = false;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await ProductTypeDeletion.DeleteIfEmptyAsync(db, id);
            _msgSuccess = result == ProductTypeDeleteResult.Deleted;
            _msg = result switch
            {
                ProductTypeDeleteResult.Deleted => "نوع لباس حذف شد؛ دسته‌بندی‌ها حفظ شدند.",
                ProductTypeDeleteResult.HasProducts => "این نوع لباس دارای محصول است و قابل حذف نیست.",
                _ => "نوع لباس قبلاً حذف شده است."
            };
            _deleteId = null;
            if (_editId == id) _editId = null;
            await Reload();
        }
        catch { _msg = "حذف انجام نشد؛ دوباره تلاش کنید."; }
        finally { _deleting = false; }
    }

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _types = await db.ProductTypes.OrderBy(t => t.DisplayOrder).ToListAsync();
        _productCounts = await db.Products.Where(p => p.ProductTypeId != null)
            .GroupBy(p => p.ProductTypeId!.Value).ToDictionaryAsync(g => g.Key, g => g.Count());
    }

    private async Task Add()
    {
        _msg = null; _msgSuccess = false;
        if (string.IsNullOrWhiteSpace(_newName)) { _msg = "نام نوع الزامی است."; return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        db.ProductTypes.Add(new ProductTypeEntity
        {
            Name = _newName.Trim(),
            FilterIcon = string.IsNullOrWhiteSpace(_newIcon) ? null : _newIcon.Trim(),
            DisplayOrder = _types.Count
        });
        await db.SaveChangesAsync();
        _newName = _newIcon = "";
        await Reload();
    }

    private async Task Move(ProductTypeEntity t, int dir)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var list = await db.ProductTypes.OrderBy(x => x.DisplayOrder).ToListAsync();
        var i = list.FindIndex(x => x.Id == t.Id);
        var j = i + dir;
        if (i < 0 || j < 0 || j >= list.Count) return;
        (list[i].DisplayOrder, list[j].DisplayOrder) = (list[j].DisplayOrder, list[i].DisplayOrder);
        await db.SaveChangesAsync();
        await Reload();
    }

    private async Task Toggle(ProductTypeEntity t)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var x = await db.ProductTypes.FindAsync(t.Id);
        if (x is not null) { x.IsActive = !x.IsActive; await db.SaveChangesAsync(); }
        await Reload();
    }

    private async Task SaveEdit(ProductTypeEntity t)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var x = await db.ProductTypes.FindAsync(t.Id);
        if (x is not null)
        {
            x.Name = _editName.Trim();
            x.FilterIcon = string.IsNullOrWhiteSpace(_editIcon) ? null : _editIcon.Trim();
            await db.SaveChangesAsync();
        }
        _editId = null;
        await Reload();
    }
}
