@page "/admin/orders"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>سفارش‌ها | پنل مدیریت پاپی</PageTitle>

<h1 style="margin-top:0">🧾 سفارش‌ها</h1>

<table class="table-papey">
    <thead><tr><th>شماره</th><th>مشتری</th><th>اقلام</th><th>مبلغ</th><th>وضعیت</th><th>تغییر وضعیت</th></tr></thead>
    <tbody>
        @foreach (var o in _orders)
        {
            <tr>
                <td><strong>@o.OrderNumber</strong><br /><small style="color:var(--papey-muted)">@PersianHelpers.ToPersianDigits(o.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm"))</small></td>
                <td>
                    @o.CustomerName<br />
                    <small style="color:var(--papey-muted)">@o.CustomerPhone<br />@o.Province، @o.City — @o.FullAddress</small>
                </td>
                <td>
                    <small>
                    @foreach (var i in o.Items)
                    {
                        <div>@i.ProductName (@i.Size/@i.Color) × @PersianHelpers.ToPersianDigits(i.Quantity.ToString())</div>
                    }
                    </small>
                </td>
                <td>@o.GrandTotal.ToToman()<br /><small style="color:var(--papey-muted)">Ref: @o.PaymentRefId</small></td>
                <td><span class="status-chip status-@o.Status">@PersianHelpers.StatusLabel(o.Status)</span></td>
                <td>
                    <select class="form-input" style="width:auto; padding:6px 10px; font-size:0.8rem"
                            value="@o.Status" @onchange="e => ChangeStatus(o, e.Value!.ToString()!)">
                        @foreach (var s in Enum.GetValues<OrderStatus>())
                        {
                            <option value="@s">@PersianHelpers.StatusLabel(s)</option>
                        }
                    </select>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Order> _orders = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _orders = await db.Orders.Include(o => o.Items).OrderByDescending(o => o.CreatedAt).ToListAsync();
    }

    private async Task ChangeStatus(Order order, string statusStr)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var tracked = await db.Orders.FindAsync(order.Id);
        if (tracked is not null && Enum.TryParse<OrderStatus>(statusStr, out var s))
        {
            tracked.Status = s;
            await db.SaveChangesAsync();
            order.Status = s;
        }
    }
}
