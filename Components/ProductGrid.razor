@namespace Papey.Components
@inject FavoriteService Favorites
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@if (Products.Count == 0)
{
    <div class="alert-papey alert-info" style="text-align:center">محصولی یافت نشد.</div>
}
else
{
    @if (ShowViewOptions)
    {
        <div class="product-grid-toolbar">
        @ToolbarStart
        <div class="product-view-options" role="group" aria-label="اندازه نمایش محصولات">
            <span class="view-options-caption">نمایش</span>
            <button type="button" class="@(!_compact ? "is-selected" : "")" aria-pressed="@(!_compact)" @onclick="() => SetCompact(false)" title="نمایش معمولی" aria-label="نمایش معمولی"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><span>معمولی</span></button>
            <button type="button" class="@(_compact ? "is-selected" : "")" aria-pressed="@_compact" @onclick="() => SetCompact(true)" title="تصاویر کوچک‌تر، محصولات بیشتر" aria-label="تصاویر کوچک‌تر، محصولات بیشتر"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h4v4H3zM10 3h4v4h-4zM17 3h4v4h-4zM3 10h4v4H3zM10 10h4v4h-4zM17 10h4v4h-4zM3 17h4v4H3zM10 17h4v4h-4zM17 17h4v4h-4z"/></svg><span>کوچک‌تر</span></button>
        </div>
        </div>
    }
    <div class="product-grid @(ShowViewOptions && _compact ? "product-grid--compact" : "")">
        @foreach (var p in Products)
        {
            <div class="product-card">
                <div class="product-media">
                @if (p.IsNew) { <span class="badge-new">جدید</span> }
                <button type="button" class="img-wrap @(SecondImage(p) is not null ? "has-second-image" : "")" aria-label="نمایش و بزرگ‌نمایی تصاویر @p.Name" aria-haspopup="dialog" @onclick="() => Preview(p)">
                    <img class="product-image-primary" src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                    @if (SecondImage(p) is string alternate) { <img class="product-image-secondary" src="@alternate" alt="" aria-hidden="true" loading="lazy" /> }
                </button>
                <button class="favorite-button @(_favoriteProductIds.Contains(p.Id) ? "is-favorite" : "")"
                        type="button"
                        title="@(_favoriteProductIds.Contains(p.Id) ? "حذف از علاقه‌مندی‌ها" : "افزودن به علاقه‌مندی‌ها")"
                        aria-label="@(_favoriteProductIds.Contains(p.Id) ? $"حذف {p.Name} از علاقه‌مندی‌ها" : $"افزودن {p.Name} به علاقه‌مندی‌ها")"
                        aria-pressed="@_favoriteProductIds.Contains(p.Id).ToString().ToLowerInvariant()"
                        @onclick="() => ToggleFavoriteAsync(p.Id)">
                    <FavoriteIcon />
                </button>
                </div>
                <div class="info">
                    <h3><a href="/product/@p.Slug">@p.Name</a></h3>
                    <div class="price-row">
                        <span class="price">@p.Price.ToToman()</span>
                        @if (p.OldPrice is not null)
                        {
                            <span class="old-price">@p.OldPrice.Value.ToToman()</span>
                        }
                    </div>
                    @if (p.OldPrice is > 0 && p.OldPrice > p.Price)
                    {
                        <span class="product-discount"><bdi>@PersianHelpers.ToPersianDigits(((int)((p.OldPrice.Value - p.Price) / p.OldPrice.Value * 100)).ToString())٪</bdi> تخفیف</span>
                    }
                </div>
            </div>
        }
    </div>
}

<ProductImageLightbox @ref="_imageViewer" />
@code {
    [Parameter] public List<Product> Products { get; set; } = new();

    [Parameter] public RenderFragment? ToolbarStart { get; set; }
    [Parameter] public bool ShowViewOptions { get; set; }
    private bool _compact;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ShowViewOptions) {
            try { _compact = await JS.InvokeAsync<bool>("papey.productView.read"); if (_compact) StateHasChanged(); }
            catch (JSException) { }
        }
    }
    private async Task SetCompact(bool value) { _compact = value; try { await JS.InvokeVoidAsync("papey.productView.write", value); } catch (JSException) { } }
    private ProductImageLightbox? _imageViewer;
    private Task Preview(Product product) => _imageViewer?.ShowAsync(new[] { product.ImageUrl }.Concat(product.Media.Where(m => m.Type == MediaType.Image).OrderBy(m => m.DisplayOrder).Select(m => m.Url)).OfType<string>(), product.Name, "/product/" + product.Slug) ?? Task.CompletedTask;
    private HashSet<int> _favoriteProductIds = [];
    private static string? SecondImage(Product product) => product.Media.Where(m => m.Type == MediaType.Image && !string.IsNullOrWhiteSpace(m.Url) && m.Url != product.ImageUrl)
        .OrderBy(m => m.DisplayOrder).ThenBy(m => m.Id).Select(m => m.Url).FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        Favorites.OnChange += RefreshFavorites;
        await LoadFavoritesAsync();
    }

    private async Task ToggleFavoriteAsync(int productId)
    {
        if (!await Favorites.ToggleAsync(productId))
        {
            var returnUrl = "/" + Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
        }
    }

    private void RefreshFavorites() => _ = LoadFavoritesAsync();

    private async Task LoadFavoritesAsync()
    {
        _favoriteProductIds = await Favorites.GetProductIdsAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Favorites.OnChange -= RefreshFavorites;
}
