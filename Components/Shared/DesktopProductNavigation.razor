<nav class="main-nav" aria-label="ناوبری اصلی">
    <NavLink href="/" Match="NavLinkMatch.All">خانه</NavLink>
    @if (Types.Count > 3)
    {
        <details class="desktop-type-menu" data-navigation-menu>
            <summary>نوع لباس <span class="type-menu-count">@PersianHelpers.ToPersianDigits(Types.Count.ToString())</span><svg class="type-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
            <div class="desktop-type-panel" style="@($"--type-category-rows:{CategoryRows}")">
                <div class="type-panel-heading"><div><small>از اینجا شروع کن</small><strong>نوع لباس</strong></div><a href="/products">کل محصولات ←</a></div>
                <div class="desktop-type-list @(Types.Count > 16 ? "has-lots-types" : Types.Count > 8 ? "has-many-types" : "")">
                @foreach (var type in Types)
                {
                    @if (type.Categories.Count > 0)
                    {
                        <details class="desktop-type-group" name="desktop-clothing-types" open="@(type.Id == Types.FirstOrDefault(t => t.Categories.Count > 0)?.Id)">
                            <summary><span class="type-rail-label"><span aria-hidden="true"><ProductTypeSymbol Value='@(string.IsNullOrWhiteSpace(type.FilterIcon) ? "👕" : type.FilterIcon)' /></span><strong>@type.Name</strong></span><svg class="type-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg></summary>
                            <div class="desktop-type-categories">
                                <a class="type-view-all" href="/products?type=@type.Id">همه @type.Name ←</a>
                                <div class="type-category-grid">
                                    @foreach (var category in type.Categories.OrderBy(c => c.DisplayOrder))
                                    {
                                        <NavLink href="@($"/category/{category.Slug}")">@category.Name</NavLink>
                                    }
                                </div>
                            </div>
                        </details>
                    }
                    else { <a class="desktop-type-direct" href="/products?type=@type.Id"><span class="type-rail-label"><span aria-hidden="true"><ProductTypeSymbol Value='@(string.IsNullOrWhiteSpace(type.FilterIcon) ? "👕" : type.FilterIcon)' /></span>@type.Name</span><span aria-hidden="true">←</span></a> }
                }
                </div>
            </div>
        </details>
    }
    else
    {
        @foreach (var type in Types)
        {
            <div class="nav-category">
                <a href="/products?type=@type.Id">@type.Name</a>
                @if (type.Categories.Count > 0)
                {
                    <div class="nav-submenu">
                        @foreach (var category in type.Categories.OrderBy(c => c.DisplayOrder))
                        {
                            <NavLink href="@($"/category/{category.Slug}")">@category.Name</NavLink>
                        }
                    </div>
                }
            </div>
        }
    }
    <NavLink class="catalog-all-link" href="/products">کل محصولات</NavLink>
    <NavLink href="/custom-design">طرح اختصاصی ✦</NavLink>
</nav>

@code {
    [Parameter] public IReadOnlyList<ProductTypeEntity> Types { get; set; } = [];
    private int CategoryRows => Math.Max(1, (Types.Select(t => t.Categories.Count).DefaultIfEmpty(0).Max() + 2) / 3);
}
