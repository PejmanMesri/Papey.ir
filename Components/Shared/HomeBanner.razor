@implements IDisposable
<section class="home-slideshow" aria-label="بنرهای فروشگاه" aria-roledescription="اسلایدشو">
    @for (var i = 0; i < Slides.Count; i++)
    {
        var slide = Slides[i];
        <div class="home-slide @(i == _index ? "is-active" : "") @(slide.IsCampaign ? "is-campaign" : "")" aria-hidden="@(i != _index)" inert="@(i != _index)">
            <div class="home-slide-art"><img src="@slide.Image" alt="@(slide.Title ?? "")" loading="@(i == 0 ? "eager" : "lazy")" fetchpriority="@(i == 0 ? "high" : "auto")" /></div>
            <div class="home-slide-copy">@if (!string.IsNullOrWhiteSpace(slide.Title)) { <h2>@slide.Title</h2> } @if (!string.IsNullOrWhiteSpace(slide.Description)) { <p>@slide.Description</p> }<a href="@slide.Link">@(slide.Link.StartsWith("/product/", StringComparison.Ordinal) ? "دیدن این طرح" : "مشاهده کالکشن") ←</a></div>
        </div>
    }
    @if (Slides.Count > 1)
    {
        <div class="banner-arrows"><button type="button" aria-label="بنر قبلی" @onclick="() => Select(_index - 1)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></button><button type="button" aria-label="بنر بعدی" @onclick="() => Select(_index + 1)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg></button></div>
        <div class="banner-dots" role="group" aria-label="انتخاب بنر">@for (var i = 0; i < Slides.Count; i++) { var index = i; <button type="button" class="@(_index == i ? "active" : "")" aria-label="@($"نمایش بنر {i + 1}")" aria-pressed="@(_index == i)" @onclick="() => Select(index)"><span></span></button> }</div>
        <button class="banner-pause" type="button" aria-label="@(_paused ? "ادامه نمایش خودکار" : "توقف نمایش خودکار")" aria-pressed="@_paused" @onclick="() => _paused = !_paused">@(_paused ? "▶" : "Ⅱ")</button>
    }
</section>
@code {
    [Parameter] public List<HomeSlide> Slides { get; set; } = [];
    [Parameter] public int IntervalSeconds { get; set; } = 6;
    private int _index;
    private bool _paused;
    private DateTime _last = DateTime.UtcNow;
    private readonly CancellationTokenSource _stop = new();
    protected override void OnParametersSet() { if (_index >= Slides.Count) _index = 0; }
    protected override Task OnAfterRenderAsync(bool firstRender) { if (firstRender) _ = Run(); return Task.CompletedTask; }
    private void Select(int index) { _index = (index + Slides.Count) % Slides.Count; _last = DateTime.UtcNow; }
    private async Task Run() { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1)); try { while (await timer.WaitForNextTickAsync(_stop.Token)) await InvokeAsync(() => { if (_paused) _last = DateTime.UtcNow; else if (Slides.Count > 1 && DateTime.UtcNow - _last >= TimeSpan.FromSeconds(Math.Clamp(IntervalSeconds, 3, 30))) { Select(_index + 1); StateHasChanged(); } }); } catch (OperationCanceledException) { } }
    public void Dispose() { _stop.Cancel(); _stop.Dispose(); }
}
