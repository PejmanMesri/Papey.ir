@using System.Globalization
@using System.Text.Json
<div class="custom-request-previews">
@foreach (var side in new[] { "front", "back" })
{
    var layers = _layers.Where(l => l.Side == side).ToArray();
    if (layers.Length == 0) continue;
    <section><h3>@(side == "front" ? "جلوی لباس" : "پشت لباس")</h3><div class="request-preview-stage"><img class="request-garment" src="@CustomDesignCatalog.Image(Request.Garment, Request.Colour, side)" alt="پیش‌نمایش @(side == "front" ? "جلو" : "پشت") لباس" /><div class="request-print-zone">
    @foreach (var layer in layers) { var placement = CustomDesignCatalog.StagePlacement(Request.Garment, layer); <img class="request-artwork" src="@($"/api/custom-designs/{Request.Id}/files/{layer.File}")" style="left:@Pct(placement.X);top:@Pct(placement.Y);width:@Pct(placement.Width);height:@Pct(placement.Height)" alt="طرح ارسالی مشتری" /> }
    </div></div></section>
}
</div>
@if (Downloads)
{
    <div class="request-downloads"><strong>فایل‌های اصلی PNG</strong>@foreach (var file in _layers.Select(l => l.File).Distinct().Order()) { <a href="@($"/api/custom-designs/{Request.Id}/files/{file}?download=true")">دریافت طرح @PersianHelpers.ToPersianDigits((file + 1).ToString()) ↓</a> }</div>
}
@code {
    [Parameter, EditorRequired] public CustomDesignRequest Request { get; set; } = null!;
    [Parameter] public bool Downloads { get; set; }
    private List<DesignLayer> _layers = [];
    protected override void OnParametersSet() { _layers = JsonSerializer.Deserialize<List<DesignLayer>>(Request.LayersJson) ?? []; }
    private static string Pct(double value) => (value * 100).ToString("0.#####", CultureInfo.InvariantCulture) + "%";
}
