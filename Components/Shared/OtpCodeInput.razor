@inject IJSRuntime JS
@implements IAsyncDisposable
<div class="otp-code-input" @ref="_root" role="group" aria-label="کد تأیید پنج‌رقمی" dir="ltr" aria-busy="@Disabled">
    @for (var i = 0; i < 5; i++)
    {
        <input type="text" inputmode="numeric" pattern="[0-9۰-۹٠-٩]*" maxlength="@(i == 0 ? 5 : 1)" autocomplete="@(i == 0 ? "one-time-code" : "off")" enterkeyhint="@(i == 4 ? "go" : "next")" aria-label="رقم @PersianHelpers.ToPersianDigits((i + 1).ToString()) از ۵" disabled="@Disabled" />
    }
</div>
@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback Completed { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<OtpCodeInput>? _self;
    private string _lastValue = "";
    private bool _sync, _wasDisabled;
    protected override void OnParametersSet() { if (Value != _lastValue) { _lastValue = Value; _sync = true; } }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/OtpCodeInput.razor.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("bind", _root, _self, Value);
            _sync = false;
        }
        else if (_sync && _module is not null) { _sync = false; await _module.InvokeVoidAsync("set", _root, Value); }
        if (_wasDisabled && !Disabled && _module is not null) await _module.InvokeVoidAsync("focus", _root);
        _wasDisabled = Disabled;
    }
    [JSInvokable] public async Task Update(string code, bool complete)
    {
        if (Disabled) return;
        code = PersianHelpers.ToEnglishDigits(code);
        if (code.Length > 5 || code.Any(c => c is < '0' or > '9')) return;
        _lastValue = code;
        await ValueChanged.InvokeAsync(code);
        if (complete && code.Length == 5) await Completed.InvokeAsync();
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null) { try { await _module.InvokeVoidAsync("dispose", _root); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } catch (TaskCanceledException) { } }
        _self?.Dispose();
    }
}
