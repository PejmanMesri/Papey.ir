@inject IJSRuntime JS
@implements IAsyncDisposable
<dialog @ref="_dialog" class="product-image-dialog" aria-label="تصاویر @_title">
    <header><div><h2>@_title</h2><small>برای دیدن جزئیات، زوم کن؛ تصویر را با انگشت یا ماوس جابه‌جا کن.</small></div><button type="button" class="viewer-close" aria-label="بستن تصاویر محصول" @onclick="Close" autofocus>×</button></header>
    <div class="viewer-photo-wrap">
        <div class="viewer-stage" data-viewer-stage>@if (_images.Count > 0) { <img src="@_images[_index]" alt="@_title" draggable="false" /> }</div>
        @if (_images.Count > 1) { <button class="viewer-prev" type="button" aria-label="تصویر قبلی" @onclick="() => Step(-1)">→</button><button class="viewer-next" type="button" aria-label="تصویر بعدی" @onclick="() => Step(1)">←</button> }
    </div>
    <footer><div class="viewer-zoom" role="group" aria-label="بزرگ‌نمایی تصویر"><button type="button" data-zoom="out" aria-label="کوچک‌نمایی">−</button><button type="button" data-zoom="reset" aria-label="اندازه اصلی"><output data-zoom-value>100%</output></button><button type="button" data-zoom="in" aria-label="بزرگ‌نمایی">+</button></div><span>@(_images.Count > 0 ? PersianHelpers.ToPersianDigits($"{_index + 1} از {_images.Count}") : "")</span>@if (!string.IsNullOrWhiteSpace(_link)) { <a href="@_link">جزئیات محصول ←</a> }</footer>
</dialog>
@code {
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ProductImageLightbox>? _self;
    private List<string> _images = [];
    private string _title = "", _link = "";
    private int _index;
    private bool _openRequested, _resetRequested;
    public Task ShowAsync(IEnumerable<string> images, string title, string? productLink = null, string? selectedImage = null)
    {
        _images = images.Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().ToList();
        if (_images.Count == 0) return Task.CompletedTask;
        _title = title; _link = productLink ?? ""; _index = Math.Max(0, _images.IndexOf(selectedImage ?? ""));
        _openRequested = true; return InvokeAsync(StateHasChanged);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_openRequested) { _openRequested = false; _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/ProductImageLightbox.razor.js"); _self ??= DotNetObjectReference.Create(this); await _module.InvokeVoidAsync("open", _dialog, _self); }
        else if (_resetRequested && _module is not null) { _resetRequested = false; await _module.InvokeVoidAsync("reset", _dialog); }
    }
    [JSInvokable] public Task Step(int delta) { if (_images.Count > 0) { _index = (_index + delta + _images.Count) % _images.Count; _resetRequested = true; } return InvokeAsync(StateHasChanged); }
    private async Task Close() { if (_module is not null) await _module.InvokeVoidAsync("close", _dialog); }
    public async ValueTask DisposeAsync() { if (_module is not null) { try { await _module.InvokeVoidAsync("dispose", _dialog); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } catch (TaskCanceledException) { } } _self?.Dispose(); }
}
