@inject IJSRuntime JS
@implements IAsyncDisposable

<button class="size-guide-trigger" type="button" @onclick="Open" aria-haspopup="dialog">
    <span class="size-guide-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="18" height="12" rx="3"/><path d="M7 6v5m5-5v3m5-3v5"/></svg></span>
    <span><strong>راهنمای انتخاب سایز</strong><small>اندازه‌ها را ببین و با لباس خودت مقایسه کن</small></span>
    <span class="size-guide-arrow" aria-hidden="true">←</span>
</button>
<dialog @ref="_dialog" class="size-guide-dialog" aria-label="راهنمای سایز @ProductName">
    <header class="size-guide-header"><div><h2>راهنمای سایز</h2><p>@ProductName</p></div><button type="button" class="size-guide-close" aria-label="بستن راهنمای سایز" @onclick="Close" autofocus>×</button></header>
    <div class="size-guide-scroll" tabindex="0" aria-label="تصویر راهنمای سایز؛ برای دیدن همه اندازه‌ها پایین بروید">
        <img src="@GuideUrl" alt="راهنمای اندازه‌گیری و جدول سایز @ProductName" />
    </div>
    <footer class="size-guide-footer"><span>برای دیدن همه اندازه‌ها، تصویر را به پایین بکش.</span><a href="@GuideUrl" target="_blank" rel="noopener">نمایش اندازه اصلی ↗</a></footer>
</dialog>

@code {
    public const string DefaultImage = "/img/size-guide-default.jpg";
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string ProductName { get; set; } = "";
    private string GuideUrl => string.IsNullOrWhiteSpace(ImageUrl) ? DefaultImage : ImageUrl;
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private async Task Open()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/ProductSizeGuide.razor.js");
        await _module.InvokeVoidAsync("open", _dialog);
    }
    private async Task Close() { if (_module is not null) await _module.InvokeVoidAsync("close", _dialog); }
    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("dispose", _dialog); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
}
