@if (ProductTypeIcons.Image(TypeName, Value) is string icon)
{
    <img class="product-type-symbol" src="@icon" alt="" aria-hidden="true" width="64" height="64" />
}
else
{
    @Value
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? TypeName { get; set; }
}
