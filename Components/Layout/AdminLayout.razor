@inherits LayoutComponentBase

<div class="admin-shell">
    <aside class="admin-side">
        <a class="brand admin-wordmark" href="/" aria-label="پاپی، صفحه اصلی فروشگاه">
            <strong lang="en">PAPEY</strong><span>پنل مدیریت</span>
        </a>
        <div class="admin-desktop-nav"><AdminNavigation /></div>
        <button type="button" class="admin-menu-toggle" data-admin-menu-open aria-haspopup="dialog" aria-controls="admin-drawer">
            <span aria-hidden="true">☰</span> منو
        </button>
        <dialog class="admin-drawer" id="admin-drawer" aria-label="منوی مدیریت">
            <header class="admin-drawer-header">
                <strong>پنل مدیریت</strong>
                <form method="dialog"><button type="submit" aria-label="بستن منو" autofocus>×</button></form>
            </header>
            <AdminNavigation />
        </dialog>
    </aside>
    <main class="admin-main">
        <div class="admin-content">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    خطایی رخ داده است.
    <a href="." class="reload">بارگذاری مجدد</a>
    <span class="dismiss">🗙</span>
</div>
