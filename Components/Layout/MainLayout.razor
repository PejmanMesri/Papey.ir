@inherits LayoutComponentBase
@inject CartService Cart
@inject FavoriteService Favorites
@inject IDbContextFactory<AppDbContext> DbFactory
@implements IDisposable

<header class="site-header">
    <div class="container-papey header-inner">
        <a class="logo" href="/">پاپی<span>.</span></a>
        <nav class="main-nav">
            <NavLink href="/" Match="NavLinkMatch.All">خانه</NavLink>
            @foreach (var type in _navTypes)
            {
                <div class="nav-category">
                    <a href="/products?type=@type.Id">@type.Name</a>
                    @if (type.Categories.Count > 0)
                    {
                        <div class="nav-submenu">
                            @foreach (var category in type.Categories.OrderBy(category => category.DisplayOrder))
                            {
                                <NavLink href="@($"/category/{category.Slug}")">@category.Name</NavLink>
                            }
                        </div>
                    }
                </div>
            }
            <NavLink href="/products">محصولات</NavLink>
            <NavLink href="/size-guide">راهنمای سایز</NavLink>
        </nav>
        <form class="search-box" method="get" action="/search">
            <button type="submit">🔍</button>
            <input type="text" name="q" placeholder="جستجوی محصول..." />
        </form>
        <div class="header-actions">
            <a href="/cart">
                🛒 سبد خرید
                @if (Cart.TotalQuantity > 0)
                {
                    <span class="cart-badge">@PersianHelpers.ToPersianDigits(Cart.TotalQuantity.ToString())</span>
                }
            </a>
            <AuthorizeView>
                <Authorized>
                    <a href="/account/favorites" class="header-favorites">
                        @(_favoriteCount > 0 ? "♥" : "♡") علاقه‌مندی‌ها
                        @if (_favoriteCount > 0)
                        {
                            <span class="cart-badge">@PersianHelpers.ToPersianDigits(_favoriteCount.ToString())</span>
                        }
                    </a>
                    @if (context.User.IsInRole("Admin"))
                    {
                        <a href="/admin">⚙️ پنل مدیریت</a>
                    }
                    <div class="account-menu">
                        <span class="account-toggle" tabindex="0">👤 حساب من ▾</span>
                        <div class="account-dropdown">
                            <a href="/account">🏠 پیشخوان</a>
                            <a href="/account/orders">🧾 سفارش‌ها</a>
                            <a href="/account/favorites">♡ علاقه‌مندی‌ها</a>
                            <a href="/account/addresses">📍 نشانی‌ها</a>
                            <a href="/account/profile">👤 جزئیات حساب</a>
                            <hr />
                            <a href="/logout">🚪 خروج</a>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="/login">ورود</a>
                    <a href="/register">ثبت‌نام</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

<main class="container-papey">
    @Body
</main>

<footer class="site-footer">
    <div class="container-papey">
        <div class="footer-grid">
            <div>
                <h4>پاپی</h4>
                <p style="font-size:0.85rem; line-height:1.9">
                    فروشگاه اینترنتی پاپی، مرجع تیشرت‌های طراحی‌شده با ایده‌های ایرانی و مدرن.
                    کیفیت پارچه و چاپ، تعهد ماست.
                </p>
            </div>
            <div>
                <h4>خدمات مشتریان</h4>
                <a href="/about">درباره ما</a>
                <a href="/contact">نحوه ارتباط با ما</a>
                <a href="/size-guide">جدول سایزبندی</a>
            </div>
            <div>
                <h4>ارتباط با ما</h4>
                <a href="tel:09036421161">📞 ۰۹۰۳۶۴۲۱۱۶۱</a>
                <a href="https://www.instagram.com/papey.ir">اینستاگرام</a>
                <a href="https://wa.me/989036421161">واتساپ</a>
            </div>
        </div>
        <div class="footer-bottom">© ۱۴۰۵ پاپی — کلیه حقوق محفوظ است | Papey.ir</div>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    خطایی رخ داده است.
    <a href="." class="reload">بارگذاری مجدد</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private List<ProductTypeEntity> _navTypes = new();
    private int _favoriteCount;

    protected override async Task OnInitializedAsync()
    {
        Cart.OnChange += StateHasChanged;
        Favorites.OnChange += RefreshFavoriteCount;
        await Cart.LoadAsync();
        await RefreshFavoriteCountAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        _navTypes = await db.ProductTypes
            .Where(type => type.IsActive)
            .Include(type => type.Categories.Where(category => category.IsActive && category.ShowInNav))
            .OrderBy(type => type.DisplayOrder)
            .ToListAsync();
    }

    private void RefreshFavoriteCount() => _ = RefreshFavoriteCountAsync();

    private async Task RefreshFavoriteCountAsync()
    {
        _favoriteCount = await Favorites.GetCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Cart.OnChange -= StateHasChanged;
        Favorites.OnChange -= RefreshFavoriteCount;
    }
}
