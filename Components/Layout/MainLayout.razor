@inherits LayoutComponentBase
@inject CartService Cart
@inject FavoriteService Favorites
@inject IDbContextFactory<AppDbContext> DbFactory
@implements IDisposable

<div class="storefront-shell">
<a class="skip-link" href="#main-content">رفتن به محتوای صفحه</a>
<header class="site-header">
    <div class="container-papey header-inner">
        <a class="logo" href="/" aria-label="پاپی، صفحه اصلی"><span class="logo-persian" aria-hidden="true">پاپی</span><span class="logo-latin" aria-hidden="true">PAPEY</span></a>
        <details class="mobile-menu" data-navigation-menu>
            <summary aria-label="منوی فروشگاه"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg><span>منو</span></summary>
            <nav class="mobile-menu-panel" aria-label="منوی فروشگاه">
                <a href="/">خانه</a>
                <details class="mobile-products"><summary><a href="/products" onclick="event.stopPropagation()">محصولات</a><span class="menu-expand" aria-label="باز کردن انواع لباس">+</span></summary>
                @foreach (var type in _navTypes) {
                    <details class="mobile-category"><summary><a href="/products?type=@type.Id" onclick="event.stopPropagation()">@type.Name</a><span class="menu-expand" aria-label="باز کردن دسته‌ها">+</span></summary>
                    @foreach (var category in type.Categories.OrderBy(c=>c.DisplayOrder)) { <a href="/category/@category.Slug">@category.Name</a> }
                    </details>
                }
                </details>
                <a href="/custom-design">سفارش اختصاصی</a><a href="/about">درباره و ارتباط با ما</a><a href="/wholesale">فروش عمده</a>

                <AuthorizeView>
                    <Authorized>
                        <a href="/account">حساب من</a>
                        <a href="/account/orders">سفارش‌های من</a>
                        <a href="/account/custom-designs">طرح‌های اختصاصی من</a>
                        <a href="/account/favorites">علاقه‌مندی‌ها</a>
                        @if (context.User.IsInRole("Admin")) { <a href="/admin">پنل مدیریت</a> }
                        <a href="/logout">خروج</a>
                    </Authorized>
                    <NotAuthorized><a href="/login">ورود به حساب</a><a href="/register">ثبت‌نام</a></NotAuthorized>
                </AuthorizeView>
            </nav>
        </details>
        <DesktopProductNavigation Types="_navTypes" />
        <form class="search-box" method="get" action="/search">
            <button type="submit" aria-label="جستجو"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg></button>
            <input type="search" name="q" aria-label="جستجوی محصول" placeholder="جستجوی طرح یا محصول..." />
        </form>
        <div class="header-actions">
            <a href="/cart" class="header-cart" aria-label="سبد خرید" title="سبد خرید">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h14l-2 9H8L5 3H2" /><circle cx="9" cy="21" r="1" /><circle cx="17" cy="21" r="1" /></svg><span class="header-cart-label">سبد خرید</span>
                @if (Cart.TotalQuantity > 0)
                {
                    <span class="cart-badge">@PersianHelpers.ToPersianDigits(Cart.TotalQuantity.ToString())</span>
                }
            </a>
            <AuthorizeView>
                <Authorized>
                    <a href="/account/favorites" class="header-favorites" aria-label="علاقه‌مندی‌ها" title="علاقه‌مندی‌ها">
                        <svg width="21" height="21" viewBox="0 0 24 24" fill="@(_favoriteCount > 0 ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" /></svg>
                        @if (_favoriteCount > 0)
                        {
                            <span class="cart-badge">@PersianHelpers.ToPersianDigits(_favoriteCount.ToString())</span>
                        }
                    </a>
                    @if (context.User.IsInRole("Admin"))
                    {
                        <a href="/admin" class="header-admin" aria-label="پنل مدیریت" title="پنل مدیریت"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></a>
                    }
                    <details class="account-menu" data-navigation-menu>
                        <summary class="account-toggle"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /></svg>حساب من <span aria-hidden="true">⌄</span></summary>
                        <div class="account-dropdown">
                            <a href="/account">🏠 پیشخوان</a>
                            <a href="/account/orders">🧾 سفارش‌ها</a>
                            <a href="/account/custom-designs">✦ طرح‌های اختصاصی من</a>
                            <a href="/account/favorites">♡ علاقه‌مندی‌ها</a>
                            <a href="/account/addresses">📍 نشانی‌ها</a>
                            <a href="/account/profile">👤 جزئیات حساب</a>
                            <hr />
                            <a href="/logout">🚪 خروج</a>
                        </div>
                    </details>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="header-auth"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v16h-6M3 12h12m-4-4 4 4-4 4" /></svg>ورود / ثبت‌نام</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>
<AuthorizeView Roles="Admin">
    <div class="admin-storefront-return"><div class="container-papey"><span>در حال مشاهده فروشگاه هستید</span><a href="/admin">بازگشت به پنل مدیریت ←</a></div></div>
</AuthorizeView>

